      "host": "rateIntelligenceQuery",
      "route": {
        "action": "project_verified_payments_to_p4"
      },
      "boundary": "tenant_safe_internal_or_admin"
    },
    "regulatoryMonitoringWorker": {
      "host": "marketPolicyAdmin",
      "route": {
        "action": "regulatory_monitoring"
      },
      "boundary": "internal_scheduler_regulatory"
    },
    "requestP4Estimate": {
      "host": "rateIntelligenceQuery",
      "route": {
        "action": "request_p4_estimate"
      },
      "boundary": "tenant_safe_internal_or_admin"
    },
    "seedP10RegulatoryControl": {
      "host": "marketPolicyAdmin",
      "route": {
        "action": "seed_p10_regulatory_control"
      },
      "boundary": "admin_or_internal_conservative_seed"
    },
    "seedP11LegalExecution": {
      "host": "marketPolicyAdmin",
      "route": {
        "action": "seed_p11_legal_execution"
      },
      "boundary": "strict_admin_conservative_seed"
    },
    "recordLegalAcceptance": {
      "host": "claimAnonPaymentsResult",
      "source_module": "base44/shared/legalAcceptance.ts",
      "route": {
        "action": "record_legal_acceptance"
      },
      "boundary": "authenticated_merchant_self"
    },
    "conversationAdmin": {
      "host": "adminSummaries",
      "source_module": "base44/shared/conversationAdminCore.ts",
      "route": {
        "action_prefix": "conversation_"
      },
      "boundary": "strict_admin"
    },
    "commandConversationAdmin": {
      "host": "adminSummaries",
      "source_module": "base44/shared/commandConversationCore.ts",
      "route": {
        "action_prefix": "command_conversation_"
      },
      "boundary": "strict_admin"
    },
    "commandRunAdmin": {
      "host": "adminSummaries",
      "source_module": "base44/shared/commandRunAdminCore.ts",
      "route": {
        "action_prefix": "command_run_"
      },
      "boundary": "strict_admin"
    }
