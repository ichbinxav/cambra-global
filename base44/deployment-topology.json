      "host": "getEuropeMarketsCommandCenter",
      "route": {
        "view": "growth",
        "action": "recompute"
      },
      "boundary": "recommendation_only_internal_or_admin"
    },
    "founderMeetingAdmin": {
      "host": "founderOSCommand",
      "route": {
        "action_family": "meeting"
      },
      "boundary": "strict_admin"
    },
    "getEuropeanGrowthCommandCenter": {
      "host": "getEuropeMarketsCommandCenter",
      "route": {
        "view": "growth"
      },
      "boundary": "internal_or_admin_read_recommendation"
    },
    "goLiveControlAdmin": {
      "host": "outboundControlAdmin",
      "route": {
        "action_family": "go_live"
      },
      "boundary": "strict_admin_or_internal_fail_closed"
    },
    "instantlyProviderAdmin": {
      "host": "outboundControlAdmin",
      "route": {
