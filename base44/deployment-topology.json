{
  "schema_version": "cambra-base44-deployment-topology-v1",
  "physical_function_target": 276,
  "truth_boundary": "Logical handlers are source modules routed through already-deployed physical entry points. Public webhooks, Stripe, billing and other sensitive boundaries are never routed through the generic admin surface.",
  "logical_routes": {
    "adminGlobalSearch": {
      "host": "adminSummaries",
      "route": {
        "action": "global_search"
      },
      "boundary": "strict_admin"
    },
    "autonomousCompanyOrchestrator": {
      "host": "autonomousOperationsSupervisor",
      "route": {
        "host_action": "autonomous_company_orchestrator"
      },
      "boundary": "internal_scheduler_or_admin"
    },
    "backfillLegacySendingProfiles": {
      "host": "outboundControlAdmin",
      "route": {
        "action": "backfill_legacy_sending_profiles"
      },
      "boundary": "strict_admin_or_internal"
    },
    "canExecuteLegalAction": {
      "host": "checkMarketCapability",
      "route": {
        "action": "can_execute_legal_action"
      },
      "boundary": "legal_evaluation_internal_or_admin"
    },
    "checkRegulatoryActivity": {
      "host": "checkMarketCapability",
      "route": {
        "action": "check_regulatory_activity"
      },
      "boundary": "regulatory_evaluation_internal_or_admin"
    },
    "commercialCampaignAdmin": {
      "host": "adminSummaries",
      "source_module": "base44/shared/commercialCampaignAdmin.ts",
      "route": {
        "action_prefix": "campaign_"
      },
      "boundary": "strict_admin"
    },
    "discoveryV2Admin": {
      "host": "adminSummaries",
      "source_module": "base44/shared/discoveryV2Admin.ts",
      "route": {
        "action_prefix": "discovery_v2_"
      },
      "boundary": "strict_admin_cost_governed_no_outbound"
    },
    "commercialExecutionDryRun": {
      "host": "outboundControlAdmin",
      "route": {
        "action": "commercial_dry_run"
      },
      "boundary": "commercial_admin_or_internal"
    },
    "commercialGoLiveReadiness": {
      "host": "outboundControlAdmin",
      "route": {
        "action": "commercial_go_live_readiness"
      },
      "boundary": "commercial_admin_or_internal_fail_closed"
    },
    "commercialStrategyAgent": {
      "host": "outboundControlAdmin",
      "route": {
        "action": "commercial_strategy"
      },
      "boundary": "commercial_admin_or_internal"
    },
    "costGovernanceWorker": {
      "host": "maintenanceEngine",
      "route": {
        "host_action": "cost_governance"
      },
      "boundary": "internal_scheduler_or_admin_financial_control"
    },
    "disasterRecoveryBackup": {
      "host": "maintenanceEngine",
