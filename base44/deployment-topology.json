    },
    "instantlyReconciliationWorker": {
      "host": "processWebhookDeadLetters",
      "route": {
        "provider_maintenance_only": true
      },
      "boundary": "internal_scheduler_paid_provider"
    },
    "instantlyWebhook": {
      "host": "resendInboundWebhook",
      "route": {
        "header": "x-cambra-instantly-secret"
