{
  "name": "Subscription",
  "type": "object",
  "description": "[QUARANTINE 2026-08-15] PURGE-2 (2026-07-24): orphan \u2014 zero src references, only referenced by startSubscription (itself quarantined), no platform trigger. NOT deleted because it holds 2 rows (2026-07-09) that may be real early-bird subscriptions. RLS tightened to admin-only for the quarantine window. If the invocation probe on startSubscription stays silent until the review date, both are safe to delete (export rows first).",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "canceled",
        "past_due",
        "trialing"
      ],
      "default": "active"
    },
    "plan": {
      "type": "string",
      "enum": [
        "lifetime_free",
        "monthly"
      ],
      "description": "Subscription plan type"
    },
    "is_free_early_bird": {
      "type": "boolean",
      "default": false
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "status",
    "plan"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}