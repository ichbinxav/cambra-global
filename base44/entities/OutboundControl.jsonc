{
  "name": "OutboundControl",
  "type": "object",
  "description": "Singleton master switch for CAMBRA autonomous acquisition sending. Keeps acquisition configured but inert until explicit admin activation.",
  "properties": {
    "control_key": {
      "type": "string"
    },
    "acquisition_enabled": {
      "type": "boolean",
      "default": false
    },
    "premium_outlook_enabled": {
      "type": "boolean",
      "default": false
    },
    "volume_resend_enabled": {
      "type": "boolean",
      "default": false
    },
    "instantly_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Independent fail-closed switch for Instantly transport. It never enables discovery or another provider."
    },
    "activated_by": {
      "type": "string"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "paused_reason": {
      "type": "string"
    },
    "preflight_status": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "NOT_RUN"]
    },
    "preflight_hash": {
      "type": "string"
    },
    "preflight_policy_id": {
      "type": "string"
    },
    "preflight_policy_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preflight_provider_scope": {
      "type": "string"
    },
    "preflight_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "preflight_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "preflight_json": {
      "type": "object"
    },
    "activation_preflight_hash": {
      "type": "string"
    },
    "control_revision": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Optimistic-CAS revision for Founder/Admin outbound state transitions."
    },
    "transition_key": {
      "type": "string",
      "description": "Opaque key for the single in-flight outbound state transition."
    },
    "transition_action": {
      "type": "string"
    },
    "transition_actor": {
      "type": "string"
    },
    "transition_preflight_hash": {
      "type": "string"
    },
    "transition_emergency_revision": {
      "type": "number",
      "minimum": 0
    },
    "transition_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "transition_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "control_key",
    "acquisition_enabled",
    "premium_outlook_enabled",
    "volume_resend_enabled",
    "instantly_enabled"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
