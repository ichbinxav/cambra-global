{
  "name": "IntegrationCredential",
  "type": "object",
  "description": "Server-only encrypted credential authority for Integration. Human/admin clients cannot read or write rows directly; backend functions expose metadata-only projections.",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "integration_id": {
      "type": "string"
    },
    "credential_key": {
      "type": "string",
      "description": "Deterministic non-secret binding key derived from brand_id + integration_id. It is not an authentication credential."
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "oauth_token",
        "api_key",
        "basic_auth",
        "webhook_secret"
      ]
    },
    "credential_ref": {
      "type": "string",
      "description": "Legacy opaque reference only. NEVER a raw or encrypted token."
    },
    "encrypted_access_token": {
      "type": "string",
      "description": "AES-256-GCM v1 ciphertext only. Never returned from a backend response or copied to Integration metadata."
    },
    "encrypted_refresh_token": {
      "type": "string",
      "description": "Optional AES-256-GCM v1 refresh-token ciphertext. Never returned from a backend response or copied to Integration metadata."
    },
    "encryption_version": {
      "type": "string",
      "enum": [
        "v1"
      ]
    },
    "credential_version": {
      "type": "integer",
      "minimum": 1
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired"
      ],
      "default": "active"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "rotated_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "brand_id",
    "integration_id",
    "credential_key",
    "credential_type",
    "credential_version",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "write": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}
