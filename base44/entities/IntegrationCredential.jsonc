{
  "name": "IntegrationCredential",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "integration_id": {
      "type": "string"
    },
    "credential_type": {
      "type": "string",
      "enum": [
        "oauth_token",
        "api_key",
        "webhook_secret"
      ]
    },
    "credential_ref": {
      "type": "string",
      "description": "Opaque reference only. NEVER the raw token."
    },
    "scopes": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired"
      ],
      "default": "active"
    }
  },
  "required": [
    "brand_id",
    "integration_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}