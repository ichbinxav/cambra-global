{
  "name": "ProviderCandidate",
  "type": "object",
  "description": "P2 discovery queue; raw discovery is never canonical truth.",
  "properties": {
    "candidate_key": {
      "type": "string"
    },
    "candidate_name": {
      "type": "string"
    },
    "market": {
      "type": "string"
    },
    "source_reference": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "DISCOVERED",
        "CANDIDATE",
        "IDENTITY_RESOLUTION",
        "VERIFICATION",
        "CLASSIFICATION",
        "MARKET_MAPPING",
        "VERIFIED",
        "REJECTED",
        "DUPLICATE",
        "RELATED_ENTITY",
        "INACTIVE",
        "UNRESOLVED"
      ]
    },
    "rejection_reason": {
      "type": "string",
      "enum": [
        "NOT_PAYMENT_RELEVANT",
        "CONSUMER_ONLY",
        "DUPLICATE",
        "INACTIVE",
        "NO_MERCHANT_OFFERING",
        "UNVERIFIABLE",
        "OUT_OF_SCOPE",
        "OTHER"
      ]
    },
    "resolved_provider_id": {
      "type": "string"
    },
    "researched_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "candidate_key",
    "candidate_name",
    "state"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
