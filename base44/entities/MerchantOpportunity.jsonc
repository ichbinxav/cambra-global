{
  "name": "MerchantOpportunity",
  "type": "object",
  "description": "Canonical P5 decision record. It separates theoretical, actionable and expected/recoverable economics and preserves the complete P1-P4 audit chain. It is intelligence output, not permission to execute P6+ workflows.",
  "properties": {
    "opportunity_key": { "type": "string" },
    "merchant_context_reference": { "type": "string" },
    "merchant_snapshot_fingerprint": { "type": "string" },
    "market": { "type": "string" },
    "currency": { "type": "string" },
    "source_provider_id": { "type": "string" },
    "source_product_id": { "type": "string" },
    "source_rate_reference": { "type": "string" },
    "target_provider_id": { "type": "string" },
    "target_product_id": { "type": "string" },
    "target_rate_reference": { "type": "string" },
    "benchmark_reference": { "type": "string" },
    "current_annual_cost_minor": { "type": "number" },
    "target_annual_cost_minor": { "type": "number" },
    "gross_theoretical_savings_minor": { "type": "number" },
    "actionable_savings_minor": { "type": "number", "description": "Null/absent until eligibility, target achievability and transition costs are evidenced." },
    "expected_recoverable_savings_minor": { "type": "number", "description": "Probability-adjusted actionable savings using an explicit integer ppm probability." },
    "annualized_savings_minor": { "type": "number" },
    "realization_probability_ppm": { "type": "number" },
    "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "evidence_completeness": { "type": "string", "enum": ["COMPLETE", "PARTIAL", "INSUFFICIENT"] },
    "opportunity_type": { "type": "string", "enum": ["THEORETICAL", "ACTIONABLE", "NEGOTIABLE", "MIGRATABLE", "RECOVERABLE"] },
    "priority_score": { "type": "number" },
    "status": { "type": "string", "enum": ["SHADOW", "AUTHORITATIVE", "DRAFT", "ACTIVE", "STALE", "DISMISSED", "REALIZED", "INVALID"] },
    "assumptions": { "type": "array", "items": { "type": "object" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "recommended_next_action": { "type": "string" },
    "evidence_references": { "type": "array", "items": { "type": "string" } },
    "dependency_references": { "type": "array", "items": { "type": "string" } },
    "version_bundle": { "type": "object" },
    "calculation_version": { "type": "string" },
    "policy_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "audit_trail": { "type": "object" }
  },
  "required": ["opportunity_key", "merchant_context_reference", "merchant_snapshot_fingerprint", "market", "currency", "source_provider_id", "current_annual_cost_minor", "target_annual_cost_minor", "gross_theoretical_savings_minor", "confidence", "evidence_completeness", "opportunity_type", "status", "version_bundle", "calculation_version", "policy_version", "generated_at", "audit_trail"],
  "rls": { "read": { "user_condition": { "role": "admin" } }, "write": { "user_condition": { "role": "admin" } } }
}
