{
  "name": "LeadDiscoveryCheckpoint",
  "type": "object",
  "description": "Provider-agnostic P6 search-space checkpoint. It preserves bounded pagination, provider health, backoff and harvest counters without making any source the canonical lead model.",
  "properties": {
    "checkpoint_key": { "type": "string" },
    "source_key": { "type": "string" },
    "provider_status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "DEGRADED", "CIRCUIT_OPEN", "EXPIRED", "UNAVAILABLE"] },
    "provider_expires_at": { "type": "string", "format": "date-time" },
    "partition_json": { "type": "object" },
    "page": { "type": "number", "minimum": 1 },
    "maximum_page": { "type": "number", "minimum": 1 },
    "total_pages_reported": { "type": "number", "minimum": 0 },
    "last_attempt_at": { "type": "string", "format": "date-time" },
    "last_success_at": { "type": "string", "format": "date-time" },
    "next_eligible_at": { "type": "string", "format": "date-time" },
    "consecutive_failures": { "type": "number", "minimum": 0 },
    "circuit_open_until": { "type": "string", "format": "date-time" },
    "api_calls": { "type": "number", "minimum": 0 },
    "candidates_scanned": { "type": "number", "minimum": 0 },
    "unique_companies_created": { "type": "number", "minimum": 0 },
    "duplicates_rejected": { "type": "number", "minimum": 0 },
    "quality_rejected": { "type": "number", "minimum": 0 },
    "enrichment_candidates": { "type": "number", "minimum": 0 },
    "provider_usage_json": { "type": "object" },
    "last_error_code": { "type": "string" },
    "engine_version": { "type": "string" }
  },
  "required": ["checkpoint_key", "source_key", "provider_status", "partition_json", "page", "engine_version"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "write": { "user_condition": { "role": "admin" } }
  }
}
