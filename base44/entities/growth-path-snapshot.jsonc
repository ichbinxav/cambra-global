{
  "name": "GrowthPathSnapshot",
  "type": "object",
  "description": "Immutable-style deterministic Actual-vs-Plan navigation snapshot. It references canonical evidence and never becomes an accounting ledger.",
  "properties": {
    "snapshot_key": { "type": "string" },
    "engine_version": { "type": "string" },
    "scenario_key": { "type": "string" },
    "status": { "type": "string", "enum": ["CURRENT", "SUPERSEDED", "ARCHIVED"] },
    "as_of": { "type": "string", "format": "date-time" },
    "actuals_json": { "type": "object" },
    "forecasts_json": { "type": "array", "items": { "type": "object" } },
    "target_gaps_json": { "type": "array", "items": { "type": "object" } },
    "revenue_bridge_json": { "type": "object" },
    "contribution_bridge_json": { "type": "object" },
    "capacity_chain_json": { "type": "object" },
    "constraints_json": { "type": "array", "items": { "type": "object" } },
    "binding_constraint_json": { "type": "object" },
    "recommendations_json": { "type": "array", "items": { "type": "object" } },
    "marginal_allocation_json": { "type": "array", "items": { "type": "object" } },
    "early_warnings_json": { "type": "array", "items": { "type": "object" } },
    "lineage_json": { "type": "array", "items": { "type": "object" } },
    "assumption_versions": { "type": "array", "items": { "type": "string" } },
    "target_versions": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number" },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["snapshot_key", "engine_version", "scenario_key", "status", "as_of", "actuals_json", "forecasts_json", "constraints_json", "lineage_json", "confidence", "created_at"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "write": { "user_condition": { "role": "admin" } }
  }
}
