{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "Owning organization for multi-tenancy. Null = platform-level key."
    },
    "name": {
      "type": "string",
      "description": "Friendly name (e.g. 'Claude Production', 'Make.com Zap')"
    },
    "tool_name": {
      "type": "string",
      "enum": [
        "claude",
        "chatgpt",
        "make",
        "n8n",
        "zapier",
        "custom",
        "other"
      ],
      "default": "custom"
    },
    "key_prefix": {
      "type": "string",
      "description": "First 8 chars of the key, shown in UI"
    },
    "key_hash": {
      "type": "string",
      "description": "SHA-256 hash of the full key. Never store the raw key."
    },
    "key_last4": {
      "type": "string"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "read",
          "write",
          "admin",
          "read:kpis",
          "read:brands",
          "read:analyses",
          "read:documents",
          "read:providers",
          "read:savings",
          "read:trackers",
          "read:reports",
          "read:integrations",
          "write:reports",
          "write:documents",
          "write:trackers",
          "trigger:analysis",
          "update:trackers",
          "manage:integrations",
          "manage:webhooks"
        ]
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "owner_email": {
      "type": "string"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_used_ip": {
      "type": "string"
    },
    "usage_count": {
      "type": "number",
      "default": 0
    },
    "rate_limit_per_minute": {
      "type": "number",
      "description": "Per-key override. Falls back to organization default (120/min)."
    },
    "ip_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "If non-empty, only requests from these IPs / CIDR ranges are allowed."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_by": {
      "type": "string"
    },
    "auth_type": {
      "type": "string",
      "enum": [
        "api_key",
        "oauth"
      ],
      "default": "api_key"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "key_prefix",
    "key_hash",
    "key_last4",
    "scopes"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}