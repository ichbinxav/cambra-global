{
  "name": "ApiUsageRecord",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "period_month": {
      "type": "string",
      "description": "YYYY-MM bucket (e.g. 2026-06)"
    },
    "request_count": {
      "type": "number",
      "default": 0
    },
    "included_quota": {
      "type": "number"
    },
    "overage_count": {
      "type": "number",
      "default": 0
    },
    "overage_amount_eur": {
      "type": "number",
      "default": 0
    },
    "billed": {
      "type": "boolean",
      "default": false
    },
    "billed_at": {
      "type": "string",
      "format": "date-time"
    },
    "billing_run_id": {
      "type": "string",
      "description": "Run that owns or completed the organization+period billing claim. Ambiguous invoice creates retain this claim; they are never blindly released."
    },
    "billing_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp for the renewable billing claim lease."
    },
    "billing_claim_revision": {
      "type": "number",
      "default": 0,
      "description": "CAS fence shared by API recording and monthly billing. Both operations increment this revision before changing the period."
    },
    "billing_execution_key": {
      "type": "string",
      "description": "Deterministic api-overage-invoice:<organization_id>:<period_month> identity."
    },
    "invoice_id": {
      "type": "string",
      "description": "Local Invoice bound to the aggregated organization+period charge; absent for a closed zero-charge period."
    },
    "stripe_invoice_id": {
      "type": "string"
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "organization_id",
    "period_month"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}
