{
  "name": "EvidenceAssertion",
  "type": "object",
  "description": "P2 normalized fact-level assertion linking a subject/predicate/object to evidence. Supports SUPPORTS/CONTRADICTS/SUPERSEDES without replacing the immutable evidence ledger.",
  "properties": {
    "assertion_key": {
      "type": "string"
    },
    "subject_type": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "object_type": {
      "type": "string"
    },
    "object_id": {
      "type": "string"
    },
    "value_json": {
      "type": "object"
    },
    "market": {
      "type": "string"
    },
    "product_id": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "evidence_id": {
      "type": "string"
    },
    "assertion_status": {
      "type": "string",
      "enum": [
        "SUPPORTS",
        "CONTRADICTS",
        "SUPERSEDES"
      ]
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_to": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN",
        "PENDING_REVIEW",
        "CONFLICTING"
      ]
    }
  },
  "required": [
    "assertion_key",
    "subject_type",
    "subject_id",
    "predicate",
    "evidence_id",
    "assertion_status",
    "verification_status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}