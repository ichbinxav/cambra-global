{
  "name": "ComplianceIssue",
  "type": "object",
  "properties": {
    "issue_key": { "type": "string" },
    "type": { "type": "string" },
    "status": { "type": "string", "enum": ["open", "reviewing", "resolved", "accepted"] },
    "review_id": {
      "type": "string",
      "description": "The ComplianceReview this issue belongs to"
    },
    "rule_id": {
      "type": "string",
      "description": "The ComplianceRule that was violated"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "high"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source_entity_type": { "type": "string" },
    "source_entity_id": { "type": "string" },
    "details_json": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" },
    "blocking": {
      "type": "boolean",
      "default": true
    },
    "resolved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "review_id",
    "rule_id",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
