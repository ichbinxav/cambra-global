{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "deal_activation_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "month": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "sent",
        "due",
        "partially_paid",
        "paid",
        "failed",
        "void",
        "disputed",
        "overdue",
        "refunded"
      ],
      "default": "draft"
    },
    "invoice_number": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "sequence": {
      "type": "number"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "subtotal_amount": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number"
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "balance_due": {
      "type": "number"
    },
    "payment_link": {
      "type": "string"
    },
    "hosted_invoice_url": {
      "type": "string"
    },
    "payment_provider": {
      "type": "string"
    },
    "processor_customer_id": {
      "type": "string"
    },
    "processor_payment_intent_id": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "last_error": {
      "type": "string"
    },
    "last_failed_at": {
      "type": "string",
      "format": "date-time"
    },
    "monthly_savings_report_id": {
      "type": "string"
    },
    "billing_snapshot_json": {
      "type": "object"
    },
    "pdf_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}