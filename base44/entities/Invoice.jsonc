{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "deal_activation_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "month": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "sent",
        "paid",
        "void",
        "disputed",
        "overdue"
      ],
      "default": "draft"
    },
    "invoice_number": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "payment_link": {
      "type": "string"
    },
    "payment_provider": {
      "type": "string"
    },
    "monthly_savings_report_id": {
      "type": "string"
    },
    "billing_snapshot_json": {
      "type": "object"
    },
    "pdf_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "amount",
    "status"
  ]
}