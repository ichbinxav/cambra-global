{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Legacy: previous ambiguous reference"
    },
    "deal_activation_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "month": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid"
      ],
      "default": "draft"
    },
    "payment_link": {
      "type": "string"
    }
  },
  "required": [
    "amount",
    "status"
  ]
}