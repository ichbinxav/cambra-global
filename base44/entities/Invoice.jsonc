{
  "name": "Invoice",
  "type": "object",
  "description": "RECOVER-4 (2026-08-04) extended this entity for the Recover Margin success-fee flow: Stripe Invoicing is the AUTHORITATIVE source of the legal invoice number (no local max+1 sequence \u2014 the pre-existing series/sequence fields are legacy and are NOT written by the Recover flow). Amounts are computed in integer cents (shared/recoverBillingMath.ts) and mirrored into the legacy EUR fields. A finalized invoice is never edited: corrections go through void / credit note / corrective invoice (\u00a732). v60.2 (2026-08-05) added contract-policy provenance fields (policy_version, snapshot_hash, policy_source) so an invoice never re-reads the live policy after creation.",
  "properties": {
    "deal_activation_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "month": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "sent",
        "due",
        "partially_paid",
        "paid",
        "failed",
        "void",
        "disputed",
        "overdue",
        "refunded"
      ],
      "default": "draft"
    },
    "invoice_number": {
      "type": "string",
      "description": "RECOVER-4 \u2014 copied from Stripe's finalized invoice `number`. Stripe is the numbering authority; never assigned locally before finalization, never reused."
    },
    "series": {
      "type": "string"
    },
    "sequence": {
      "type": "number"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "subtotal_amount": {
      "type": "number"
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number"
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "balance_due": {
      "type": "number"
    },
    "payment_link": {
      "type": "string"
    },
    "hosted_invoice_url": {
      "type": "string"
    },
    "payment_provider": {
      "type": "string"
    },
    "processor_customer_id": {
      "type": "string"
    },
    "processor_payment_intent_id": {
      "type": "string"
    },
    "retry_count": {
      "type": "number",
      "default": 0
    },
    "last_error": {
      "type": "string"
    },
    "last_failed_at": {
      "type": "string",
      "format": "date-time"
    },
    "monthly_savings_report_id": {
      "type": "string"
    },
    "execution_key": {
      "type": "string",
      "description": "P6 \u2014 deterministic local execution identity for Recover invoices (`recover-invoice:<monthly_savings_report_id>`). Used for replay-safe draft claiming and duplicate healing; Stripe idempotency remains the external exactly-once authority."
    },
    "billing_snapshot_json": {
      "type": "object",
      "description": "RECOVER-4 \u2014 the immutable accounting/tax snapshot: report figures, baseline, fee percentages, tax decision, VIES evidence, supplier/customer details, period, rounding, Stripe references, calculation hash. v60.2 \u2014 also carries the contract policy provenance (policy_version, policy_source, snapshot_hash). Append-only after finalization."
    },
    "pdf_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "organization_id": {
      "type": "string",
      "description": "RECOVER-4 \u2014 today organization = Brand.id (same convention as Mandate.organization_id)."
    },
    "mandate_id": {
      "type": "string"
    },
    "baseline_id": {
      "type": "string"
    },
    "tax_treatment": {
      "type": "string",
      "enum": [
        "FR_STANDARD_TVA",
        "ES_EU_REVERSE_CHARGE",
        "TAX_REVIEW_REQUIRED",
        "UNSUPPORTED_JURISDICTION"
      ],
      "description": "RECOVER-4 \u2014 output of the shared tax engine at issuance. Only FR_STANDARD_TVA / ES_EU_REVERSE_CHARGE can reach a finalized invoice."
    },
    "tax_rate": {
      "type": "number",
      "description": "RECOVER-4 \u2014 applied rate as a percentage (20 for FR standard, 0 for reverse charge)."
    },
    "supplier_legal_name": {
      "type": "string"
    },
    "supplier_address": {
      "type": "string"
    },
    "supplier_vat_number": {
      "type": "string"
    },
    "customer_legal_name": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "customer_country": {
      "type": "string"
    },
    "customer_vat_number": {
      "type": "string"
    },
    "vies_status": {
      "type": "string",
      "description": "RECOVER-4 \u2014 VIES state at issuance (valid / manual_review_approved / \u2026). Frozen evidence, not a live pointer."
    },
    "vies_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "vies_evidence_json": {
      "type": "object",
      "description": "RECOVER-4 \u2014 sanitized VIES response snapshot (consultation id, name/address returned, service status). Never shown to other merchants."
    },
    "service_period_start": {
      "type": "string",
      "format": "date"
    },
    "service_period_end": {
      "type": "string",
      "format": "date"
    },
    "fee_net_amount": {
      "type": "number",
      "description": "RECOVER-4 \u2014 CAMBRA fee net of VAT/TVA in EUR (equals subtotal_amount for Recover invoices)."
    },
    "discount_type": {
      "type": "string",
      "description": "RECOVER-4 \u2014 'referral_commercial_discount' when a referral discount lowered the fee pct."
    },
    "discount_amount": {
      "type": "number",
      "description": "RECOVER-4 \u2014 informative EUR delta vs the 25% standard fee. The discount is applied to the fee PERCENTAGE, not as a credit line."
    },
    "stripe_invoice_id": {
      "type": "string"
    },
    "stripe_invoice_status": {
      "type": "string",
      "description": "RECOVER-4 \u2014 last Stripe invoice status seen (draft/open/paid/void/uncollectible)."
    },
    "stripe_charge_id": {
      "type": "string"
    },
    "stripe_payment_method_type": {
      "type": "string",
      "description": "RECOVER-4 \u2014 card / sepa_debit, from the payment attempt."
    },
    "stripe_event_last_processed": {
      "type": "string",
      "description": "RECOVER-4/P6 \u2014 id of the last Stripe webhook event observed. P6 does not trust delivery order: invoice state is reconciled against a fresh Stripe GET before local mutation."
    },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "pending",
        "ok",
        "drift_corrected",
        "mismatch",
        "error"
      ],
      "description": "P6 \u2014 local\u2194Stripe reconciliation state. A mismatch never rewrites frozen invoice economics; it quarantines the row for operator review."
    },
    "last_reconciled_at": {
      "type": "string",
      "format": "date-time",
      "description": "P6 \u2014 last successful or attempted authoritative Stripe reconciliation."
    },
    "reconciliation_error": {
      "type": "string",
      "description": "P6 \u2014 normalized reconciliation blocker; never contains Stripe secrets or raw payloads."
    },
    "invoice_snapshot_hash": {
      "type": "string",
      "description": "RECOVER-4 \u2014 SHA-256 of billing_snapshot_json at finalization. Append-only."
    },
    "invoice_finalized_at": {
      "type": "string",
      "format": "date-time"
    },
    "collection_scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "prenotification_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "provider_managed",
        "sent",
        "pending"
      ],
      "description": "RECOVER-4 \u2014 SEPA pre-notification handling. 'provider_managed' when Stripe (its Creditor ID + automatic emails) carries the notification duty; CAMBRA never sends a second contradictory one."
    },
    "credit_note_id": {
      "type": "string",
      "description": "RECOVER-4 \u2014 Stripe credit note id when this invoice was (partially) credited."
    },
    "void_reason": {
      "type": "string"
    },
    "policy_version": {
      "type": "string",
      "description": "v60.2 (2026-08-05) \u2014 policyVersion in force when this invoice was finalized. Frozen at creation; the invoice never re-reads the live policy. Optional; absent on legacy invoices."
    },
    "snapshot_hash": {
      "type": "string",
      "description": "v60.2 \u2014 acceptance_snapshot_hash of the mandate whose terms this invoice was issued against. Optional; absent on legacy invoices."
    },
    "policy_source": {
      "type": "string",
      "description": "v60.2 \u2014 provenance of the policy terms: 'product_policy_registry' or 'legacy_pre_policy_registry'. Optional."
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}