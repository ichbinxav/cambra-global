{
  "name": "CommunicationThread",
  "type": "object",
  "description": "Canonical bidirectional commercial/operations conversation. Admin-only; messages carry provenance and provider ids.",
  "properties": {
    "thread_key": {
      "type": "string"
    },
    "engine": {
      "type": "string",
      "enum": [
        "merchant_acquisition",
        "partner_acquisition",
        "provider_negotiation",
        "merchant_operations",
        "support",
        "aggregate_procurement"
      ]
    },
    "related_entity_type": {
      "type": "string"
    },
    "related_entity_id": {
      "type": "string"
    },
    "recover_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "counterparty_email": {
      "type": "string"
    },
    "counterparty_name": {
      "type": "string"
    },
    "counterparty_role": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "relationship_type": {
      "type": "string",
      "enum": ["merchant", "provider", "partner", "agency", "accountant", "strategic"]
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "fr",
        "es"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "awaiting_counterparty",
        "awaiting_cambra",
        "awaiting_approval",
        "closed",
        "suppressed"
      ],
      "default": "open"
    },
    "classification": {
      "type": "string"
    },
    "conversation_state": {
      "type": "string",
      "enum": [
        "AI_HANDLING",
        "AI_NEGOTIATING",
        "HUMAN_MEETING_RECOMMENDED",
        "MEETING_PROPOSED",
        "MEETING_SCHEDULING",
        "MEETING_BOOKED",
        "FOUNDER_PREP_REQUIRED",
        "FOUNDER_MEETING",
        "MEETING_COMPLETED",
        "POST_MEETING_FOLLOWUP",
        "AI_RESUMED",
        "CLOSED_WON",
        "CLOSED_LOST",
        "PAUSED",
        "NURTURE",
        "LEGAL_BLOCKED",
        "WAITING_COUNTERPARTY",
        "WAITING_APPROVAL"
      ],
      "default": "AI_HANDLING"
    },
    "current_intent": {
      "type": "string"
    },
    "objection_category": {
      "type": "string"
    },
    "negotiation_memory_json": {
      "type": "object",
      "description": "Thread-specific offers, objections, concessions, authority boundaries and next action. Never shared across tenants as raw terms."
    },
    "policy_key": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "external_thread_id": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_action_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_inbound_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_outbound_at": {
      "type": "string",
      "format": "date-time"
    },
    "automation_paused": {
      "type": "boolean",
      "default": false
    },
    "pause_reason": {
      "type": "string"
    },
    "sending_profile_key": {
      "type": "string",
      "description": "Canonical outbound profile resolved server-side. Automatic transport fails closed when absent or invalid."
    },
    "sending_profile_resolution_status": {
      "type": "string",
      "enum": [
        "RESOLVED",
        "REVIEW_REQUIRED",
        "NOT_APPLICABLE"
      ],
      "description": "Pre-launch migration state. REVIEW_REQUIRED threads are explicitly paused rather than assigned an invented profile."
    },
    "sending_profile_resolution_reason": {
      "type": "string"
    },
    "sending_profile_resolver_version": {
      "type": "string"
    },
    "sending_profile_resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "sending_profile_resolved_by": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "counterparty_timezone": {
      "type": "string",
      "description": "IANA timezone when reliably known; otherwise Europe/Paris fallback is used."
    },
    "experiment_key": {
      "type": "string"
    },
    "experiment_variant": {
      "type": "string"
    },
    "personalization_json": {
      "type": "object"
    },
    "meeting_event_id": {
      "type": "string"
    },
    "meeting_status": {
      "type": "string",
      "enum": ["recommended", "proposed", "scheduling", "booked", "in_progress", "completed", "cancelled", "no_show" ]
    },
    "meeting_type": {
      "type": "string",
      "enum": [
        "MERCHANT_SALES_CALL",
        "MERCHANT_NEGOTIATION_CALL",
        "PROVIDER_NEGOTIATION_CALL",
        "PARTNERSHIP_CALL",
        "STRATEGIC_RELATIONSHIP_CALL",
        "MIGRATION_CALL",
        "LEGAL_COMMERCIAL_CALL"
      ]
    },
    "meeting_mode": {
      "type": "string",
      "enum": ["DISABLED", "RECOMMEND_ONLY", "PROPOSE", "AUTO_BOOK_WITHIN_POLICY"]
    },
    "founder_meeting_policy_version": {
      "type": "string"
    },
    "founder_meeting_policy_snapshot_json": {
      "type": "object"
    },
    "founder_escalation_score": {
      "type": "number"
    },
    "founder_escalation_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "founder_expected_value_minor": {
      "type": "number"
    },
    "counterparty_requested_founder": {
      "type": "boolean",
      "default": false
    },
    "meeting_start_at": {
      "type": "string",
      "format": "date-time"
    },
    "meeting_end_at": {
      "type": "string",
      "format": "date-time"
    },
    "post_meeting_status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "suppressed",
        "not_applicable"
      ],
      "default": "not_applicable"
    },
    "meeting_classification": {
      "type": "string",
      "enum": [
        "low_value",
        "operational",
        "technical",
        "commercial",
        "strategic",
        "legal",
        "executive"
      ]
    },
    "founder_required": {
      "type": "boolean",
      "default": false
    },
    "meeting_brief_json": {
      "type": "object",
      "description": "Structured pre-meeting brief derived only from real thread/provider/account context. Never fabricated meeting notes."
    },
    "meeting_outcome_json": {
      "type": "object",
      "description": "Founder-captured structured outcome separating discussed, agreed, proposed and approval-required items."
    },
    "meeting_outcome_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "meeting_follow_up_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "meeting_no_show_count": {
      "type": "number",
      "default": 0
    },
    "market_jurisdiction": {
      "type": "string",
      "description": "P1 execution jurisdiction for deterministic market gates when this thread is cut over."
    },
    "market_policy_rollout": {
      "type": "string",
      "enum": [
        "legacy",
        "shadow",
        "partial",
        "production"
      ],
      "default": "legacy"
    }
  },
  "required": [
    "thread_key",
    "engine",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
