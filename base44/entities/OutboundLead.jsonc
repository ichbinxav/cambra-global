{
  "name": "OutboundLead",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "company_domain": {
      "type": "string"
    },
    "contact_full_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_title": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "lead",
        "enriched",
        "scored",
        "contacted",
        "meeting",
        "won",
        "lost"
      ],
      "default": "lead"
    },
    "score": {
      "type": "number",
      "description": "0-100 fit score from leadScoringAgent"
    },
    "score_breakdown_json": {
      "type": "object",
      "description": "Reasoning behind the score"
    },
    "next_action": {
      "type": "string",
      "description": "Suggested next action from agents"
    },
    "source": {
      "type": "string",
      "description": "apollo, clay, manual, etc."
    },
    "enriched": {
      "type": "boolean",
      "default": false
    },
    "enrichment_json": {
      "type": "object"
    },
    "attio_record_id": {
      "type": "string",
      "description": "Filled when CRM agent pushes to Attio"
    },
    "raw_json": {
      "type": "object",
      "description": "Raw payload from source for traceability"
    },
    "legal_basis": {
      "type": "string",
      "enum": [
        "consent",
        "contract",
        "legitimate_interest",
        "legal_obligation",
        "vital_interests",
        "public_task"
      ],
      "description": "GDPR Art. 6(1) legal basis for processing this personal data. REQUIRED for every OutboundLead produced from now on. Populated at ingestion time by whichever agent creates the lead (e.g. leadDiscoveryAgent tags Apollo-sourced leads as 'legitimate_interest' with a documented LIA note). Historical rows created before this field existed leave it empty \u2014 those are the ones the GDPR agent flagged as needing retroactive audit."
    },
    "legal_basis_note": {
      "type": "string",
      "description": "Human-readable justification supporting the chosen legal_basis. For 'legitimate_interest' this doubles as the LIA (Legitimate Interest Assessment) summary \u2014 e.g. 'B2B outreach to publicly listed decision-maker at a commerce brand; contact from Apollo under their DPA; opt-out available in every outreach.'"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}