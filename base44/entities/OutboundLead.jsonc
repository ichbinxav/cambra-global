{
  "name": "OutboundLead",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string"
    },
    "company_domain": {
      "type": "string"
    },
    "contact_full_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_title": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "lead",
        "enriched",
        "scored",
        "outreach_ready",
        "waiting_window",
        "waiting_capacity",
        "suppressed",
        "disqualified",
        "contacted",
        "meeting",
        "won",
        "lost"
      ],
      "default": "lead"
    },
    "score": {
      "type": "number",
      "description": "0-100 fit score from leadScoringAgent"
    },
    "score_breakdown_json": {
      "type": "object",
      "description": "Reasoning behind the score"
    },
    "next_action": {
      "type": "string",
      "description": "Suggested next action from agents"
    },
    "source": {
      "type": "string",
      "description": "apollo, clay, manual, etc."
    },
    "canonical_company_key": {
      "type": "string",
      "description": "Provider-independent normalized company key, normally domain:<host>. Used for global company deduplication before paid enrichment."
    },
    "external_refs_json": {
      "type": "object",
      "description": "Provider identifiers and provenance references only. Provider-specific IDs never become CAMBRA's canonical identity."
    },
    "source_evidence_json": {
      "type": "object",
      "description": "Observed discovery evidence, source timestamps and estimation boundaries."
    },
    "discovered_at": { "type": "string", "format": "date-time" },
    "last_source_checked_at": { "type": "string", "format": "date-time" },
    "last_enriched_at": { "type": "string", "format": "date-time" },
    "employee_range": { "type": "string" },
    "revenue_range": { "type": "string" },
    "detected_technologies": { "type": "array", "items": { "type": "string" } },
    "ecommerce_platform": { "type": "string" },
    "probable_payment_stack": { "type": "array", "items": { "type": "string" } },
    "estimated_tpv_min_eur": { "type": "number", "minimum": 0 },
    "estimated_tpv_max_eur": { "type": "number", "minimum": 0 },
    "estimated_opportunity_min_eur": { "type": "number", "minimum": 0 },
    "estimated_opportunity_max_eur": { "type": "number", "minimum": 0 },
    "estimation_status": {
      "type": "string",
      "enum": ["PRE_ANALYSIS_ESTIMATE", "VERIFIED_OPPORTUNITY", "UNKNOWN"],
      "default": "UNKNOWN"
    },
    "pre_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "enrichment_worthy": { "type": "boolean", "default": false },
    "contactability": { "type": "string", "enum": ["UNKNOWN", "UNAVAILABLE", "UNVERIFIED", "PROFESSIONAL_VERIFIED"] },
    "email_verification_status": { "type": "string" },
    "outreach_eligibility": { "type": "string", "enum": ["NOT_ASSESSED", "REVIEW_REQUIRED", "ELIGIBLE", "BLOCKED"] },
    "compliance_status": { "type": "string", "enum": ["NOT_ASSESSED", "REVIEW_REQUIRED", "CLEARED", "BLOCKED"] },
    "enriched": {
      "type": "boolean",
      "default": false
    },
    "enrichment_json": {
      "type": "object"
    },
    "attio_record_id": {
      "type": "string",
      "description": "Filled when CRM agent pushes to Attio"
    },
    "raw_json": {
      "type": "object",
      "description": "Raw payload from source for traceability"
    },
    "legal_basis": {
      "type": "string",
      "enum": [
        "legitimate_interest",
        "consent"
      ],
      "description": "GDPR Art. 6(1) legal basis for processing this personal data. Purely additive \u2014 no migration, historical rows leave it null. Populated at ingestion time by whichever agent creates the lead (leadDiscoveryAgent tags Apollo-sourced leads as 'legitimate_interest' with a documented note)."
    },
    "legal_basis_note": {
      "type": "string",
      "description": "Human-readable justification supporting the chosen legal_basis. For 'legitimate_interest' this doubles as the LIA (Legitimate Interest Assessment) summary."
    },
    "revenue_stage": {
      "type": "string",
      "enum": [
        "discovered",
        "enriched",
        "qualified",
        "outreach_ready",
        "contacted",
        "engaged",
        "discovery",
        "analysis_pending",
        "analyzed",
        "proposal",
        "recover",
        "won",
        "lost",
        "nurture",
        "reactivation"
      ]
    },
    "revenue_opportunity_score": {
      "type": "number",
      "description": "0-100 deterministic bounded priority projection: expected revenue \u00d7 probability \u00d7 strategic value. Does not invent missing economics."
    },
    "expected_revenue_value": {
      "type": "number"
    },
    "close_probability": {
      "type": "number"
    },
    "strategic_value": {
      "type": "number"
    },
    "revenue_confidence": {
      "type": "number"
    },
    "next_action_at": {
      "type": "string",
      "format": "date-time"
    },
    "sales_owner": {
      "type": "string"
    },
    "reservoir_state": {
      "type": "string",
      "enum": ["discovered","enriching","qualified","ready","queued","waiting_window","waiting_capacity","suppressed","disqualified","converted"],
      "description": "Durable always-on acquisition reservoir state. Discovery/preparation is independent from send windows."
    },
    "reservoir_updated_at": { "type": "string", "format": "date-time" },
    "outreach_ready_at": { "type": "string", "format": "date-time" },
    "last_verified_at": { "type": "string", "format": "date-time" },
    "suppression_reason": { "type": "string" }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
