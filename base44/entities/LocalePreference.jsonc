{
  "name":"LocalePreference","type":"object","description":"P9 explicit user/merchant locale preference. Language, locale, market and currency remain separate; explicit user choice wins and geolocation never locks it.",
  "properties":{"preference_key":{"type":"string"},"user_id":{"type":"string"},"brand_id":{"type":"string"},"locale":{"type":"string"},"language":{"type":"string"},"market_code":{"type":"string"},"currency":{"type":"string"},"timezone":{"type":"string"},"timezone_mode":{"type":"string","enum":["automatic","explicit"]},"date_format":{"type":"string","description":"Founder display preference only; canonical event timestamps remain unchanged."},"number_format":{"type":"string","description":"Founder display preference only; raw numeric values remain unchanged."},"currency_format":{"type":"string","description":"Founder display preference only; original financial currency remains authoritative."},"first_day_of_week":{"type":"number","minimum":0,"maximum":6},"source":{"type":"string","enum":["explicit_user","merchant_preference","admin","migration"]},"registry_version":{"type":"string"},"updated_at":{"type":"string","format":"date-time"}},
  "required":["preference_key","locale","language","source","registry_version","updated_at"],
  "rls": {
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "data.user_id": "{{user.id}}" }
      ]
    },
    "write": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "data.user_id": "{{user.id}}" }
      ]
    }
  }
}
