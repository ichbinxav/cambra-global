{
  "name": "MonthlySavingsReport",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Legacy: previous ambiguous reference"
    },
    "deal_activation_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "month": {
      "type": "string"
    },
    "gmv_real": {
      "type": "number"
    },
    "baseline_cost": {
      "type": "number"
    },
    "actual_cost": {
      "type": "number"
    },
    "savings": {
      "type": "number"
    },
    "node_fee": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "calculated",
        "invoiced",
        "paid",
        "pending"
      ],
      "default": "calculated"
    },
    "confidence_score": {
      "type": "number"
    }
  },
  "required": [
    "month",
    "status"
  ]
}