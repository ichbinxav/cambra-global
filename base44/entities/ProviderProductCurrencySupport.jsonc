{
  "name": "ProviderProductCurrencySupport",
  "type": "object",
  "description": "P2 product \u00d7 market \u00d7 currency support. Currency support is typed by usage and never inferred solely from a market primary currency.",
  "properties": {
    "currency_support_key": {
      "type": "string"
    },
    "provider_product_id": {
      "type": "string"
    },
    "market": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "usage_type": {
      "type": "string",
      "enum": [
        "PRESENTMENT",
        "PROCESSING",
        "SETTLEMENT",
        "PAYOUT",
        "BILLING",
        "UNKNOWN"
      ]
    },
    "support_state": {
      "type": "string",
      "enum": [
        "SUPPORTED",
        "LIMITED",
        "UNSUPPORTED",
        "UNKNOWN",
        "NOT_RESEARCHED"
      ]
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_to": {
      "type": "string",
      "format": "date-time"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "currency_support_key",
    "provider_product_id",
    "market",
    "currency",
    "usage_type",
    "support_state"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}