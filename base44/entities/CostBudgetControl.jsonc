{
  "name": "CostBudgetControl",
  "type": "object",
  "description": "Founder-approved daily/monthly spend ceilings for paid AI, API, enrichment and email execution. Missing or invalid active limits mean zero autonomous paid execution.",
  "properties": {
    "control_key": { "type": "string" },
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "active", "paused", "superseded"], "default": "draft" },
    "currency": { "type": "string", "enum": ["EUR"] },
    "daily_total_limit_minor": { "type": "number", "minimum": 1 },
    "monthly_total_limit_minor": { "type": "number", "minimum": 1 },
    "category_limits_json": { "type": "object", "description": "ai/api/enrichment/email each require positive daily_limit_minor and monthly_limit_minor values." },
    "estimated_unit_cost_minor_json": { "type": "object", "description": "Conservative reservation cost per provider operation, in minor currency units." },
    "anomaly_warning_pct": { "type": "number", "minimum": 1, "maximum": 100 },
    "hard_stop_pct": { "type": "number", "minimum": 1, "maximum": 100 },
    "reservation_revision": { "type": "number", "minimum": 0, "description": "Optimistic-CAS revision for concurrent paid-operation reservations." },
    "reservation_day_key": { "type": "string" },
    "reservation_month_key": { "type": "string" },
    "reserved_daily_total_minor": { "type": "number", "minimum": 0 },
    "reserved_monthly_total_minor": { "type": "number", "minimum": 0 },
    "reserved_category_json": { "type": "object", "description": "CAS-protected daily/monthly reserved totals per cost category." },
    "reservation_recent_event_keys": { "type": "array", "items": { "type": "string" }, "description": "Bounded recent idempotency claims used to stop concurrent duplicate paid execution before the usage event is persisted." },
    "send_reservation_state_json": { "type": "object", "description": "CAS-protected profile/day, exact policy-version/day and profile/minute send-slot counters plus a bounded idempotency claim journal. Uses reservation_revision; claims are never rolled back after provider execution starts." },
    "emergency_stop_active": { "type": "boolean", "default": false },
    "emergency_stop_reason": { "type": "string" },
    "emergency_stop_key": { "type": "string", "description": "Opaque ownership key of the latest CAS-protected cost stop." },
    "emergency_stop_owner": { "type": "string" },
    "emergency_stop_kind": { "type": "string", "enum": ["runtime", "operator_drill", "bootstrap"] },
    "emergency_stop_activated_at": { "type": "string", "format": "date-time" },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["control_key", "version", "status", "currency", "reservation_revision", "reservation_day_key", "reservation_month_key", "reserved_daily_total_minor", "reserved_monthly_total_minor", "reserved_category_json", "reservation_recent_event_keys", "emergency_stop_active"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "write": { "user_condition": { "role": "admin" } }
  }
}
