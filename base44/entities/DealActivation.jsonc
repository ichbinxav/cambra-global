{
  "name": "DealActivation",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "deal_application_id": {
      "type": "string"
    },
    "catalog_deal_id": {
      "type": "string"
    },
    "deal_name": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "description": "DEPRECATED: legacy provider name. Read-only."
    },
    "vertical": {
      "type": "string",
      "enum": [
        "payments",
        "shipping",
        "saas"
      ]
    },
    "provider_from": {
      "type": "string"
    },
    "provider_to": {
      "type": "string"
    },
    "projected_savings_monthly": {
      "type": "number"
    },
    "projected_savings_annual": {
      "type": "number"
    },
    "estimated_savings_yearly": {
      "type": "number"
    },
    "activated_savings_yearly": {
      "type": "number"
    },
    "potential_savings_yearly": {
      "type": "number"
    },
    "realized_savings_monthly": {
      "type": "number"
    },
    "realized_savings_yearly": {
      "type": "number"
    },
    "node_share_percent": {
      "type": "number",
      "default": 25
    },
    "billing_model": {
      "type": "string",
      "enum": [
        "monthly_success_fee"
      ],
      "default": "monthly_success_fee"
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "proposed",
        "activated",
        "awaiting_authorization",
        "authorized",
        "migrating",
        "live",
        "monetizing",
        "paused",
        "revoked",
        "closed"
      ],
      "default": "proposed"
    },
    "realization_mode": {
      "type": "string",
      "enum": [
        "verified",
        "simulated",
        "hybrid"
      ],
      "default": "simulated"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "payment_method_status": {
      "type": "string",
      "enum": [
        "none",
        "setup_started",
        "ready",
        "failed"
      ],
      "default": "none",
      "description": "RECOVER-2 (2026-08-03) \u2014 state of the merchant's payment method for the success fee on THIS activation. 'setup_started' = a SetupIntent exists but the merchant has not completed it (so nothing is chargeable yet); 'ready' = a payment method is attached and usable for future invoices. DELIBERATELY SEPARATE FROM status: the mandate (status='authorized') is the legal authorization to act, this is the operational ability to collect. An activation can be authorized with payment_method_status='none' \u2014 that is a real, expected state, and it is the gap that must be closed before the first invoice, not a contradiction. Never set to 'ready' from a client payload: only from a server-side read of the SetupIntent (or, later, the Stripe webhook), because a browser can claim anything."
    },
    "stripe_setup_intent_id": {
      "type": "string",
      "description": "RECOVER-2 \u2014 id of the most recent SetupIntent created for this activation, in CAMBRA's own billing account. Kept so the setup can be resumed (the same intent is reused while it is still usable) instead of littering the account with one intent per page reload."
    },
    "stripe_payment_method_id": {
      "type": "string",
      "description": "RECOVER-2 \u2014 the payment method the merchant authorized for future success-fee invoices, as confirmed by the SetupIntent. Read from Stripe server-side, never accepted from the client."
    },
    "stripe_billing_mode": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ],
      "description": "RECOVER-2 \u2014 which CAMBRA Stripe environment the ids above belong to ('test' = sandbox acct_1TqFip2Vr0WW305e, 'live' = acct_1TqFifJw0ka9dDf4). A Stripe Sandbox is a separate account with its own object space, so a setup intent / payment method / customer from the sandbox does not exist in live. Recorded per activation so a mode switch is DETECTED and the setup redone, rather than failing with 'no such payment method' on the first real invoice."
    },
    "payment_method_ready_at": {
      "type": "string",
      "format": "date-time",
      "description": "RECOVER-2 \u2014 when the payment method became usable (payment_method_status \u2192 'ready'), verified server-side against Stripe."
    },
    "conditions_activated_at": {
      "type": "string",
      "format": "date-time",
      "description": "RECOVER-4 (2026-08-04) \u2014 the REAL date the newly approved conditions started applying, backed by verifiable evidence (provider confirmation, pricing schedule, first settlement at new rates, API verification or documented admin review). NEVER inferred from the RECOVER-1 acceptance, the SetupIntent, a frontend edit or an estimated migration date. Set only through the documented admin verification (recordConditionsActivation flow); its Europe/Paris calendar date anchors the whole contractual measurement calendar."
    },
    "conditions_activation_source": {
      "type": "string",
      "enum": [
        "provider_confirmation",
        "pricing_schedule",
        "first_settlement",
        "api_verification",
        "admin_documented_review"
      ],
      "description": "RECOVER-4 \u2014 the class of evidence behind conditions_activated_at."
    },
    "conditions_activation_verified_by": {
      "type": "string",
      "description": "RECOVER-4 \u2014 admin who verified the activation evidence."
    },
    "conditions_activation_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_measurement_month": {
      "type": "string",
      "description": "RECOVER-4 \u2014 YYYY-MM: first FULL calendar month after conditions_activated_at (Europe/Paris). The activation month itself is never billable (\u00a77)."
    },
    "agreement_end_at": {
      "type": "string",
      "format": "date-time",
      "description": "RECOVER-4 \u2014 end of the 24 contractual measured months. No period after this instant is measured or invoiced."
    },
    "first_invoice_eligible_at": {
      "type": "string",
      "format": "date-time",
      "description": "RECOVER-4 \u2014 earliest instant the first invoice may be issued (the month after the first measured month, once verified)."
    },
    "first_invoice_issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "RECOVER-4 \u2014 when the first finalized invoice was issued. The first PAID invoice moves status live \u2192 monetizing (webhook-driven, idempotent)."
    },
    "recovery_economics_version": {
      "type": "string",
      "description": "Recover Economics version frozen for this activated Recover. New V2: recover-economics-v2; legacy rows absent."
    },
    "recovery_term_start_date": {
      "type": "string",
      "format": "date",
      "description": "V2 load-bearing Paris calendar date when verified new conditions became effective."
    },
    "recovery_term_year2_start_date": {
      "type": "string",
      "format": "date",
      "description": "V2 exact 12-month anniversary; Year 2 starts on this date."
    },
    "recovery_term_end_date": {
      "type": "string",
      "format": "date",
      "description": "V2 exclusive end date exactly 24 months after recovery_term_start_date. Fee is 0 on/after this date."
    },
    "economic_right_status": {
      "type": "string",
      "enum": [
        "pending_activation",
        "active",
        "expired",
        "waived",
        "disputed"
      ],
      "description": "Economic right is independent from the operational mandate/service lifecycle. V2 becomes active only after evidenced conditions activation."
    },
    "service_cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional service-level cancellation marker. Does not by itself terminate an already-active V2 Recovery Term."
    },
    "verification_access_status": {
      "type": "string",
      "enum": [
        "connected",
        "alternative_evidence",
        "missing",
        "not_required"
      ],
      "description": "Operational visibility for post-cancellation savings verification; never substitutes for evidence."
    },
    "recovery_attribution_key": {
      "type": "string",
      "description": "V2 stable cost-line attribution key. A second active Recovery with the same key is blocked unless a future explicit attribution/supersession flow resolves it."
    },
    "recovery_mandate_id": {
      "type": "string",
      "description": "V2 immutable pointer to the signed Mandate whose accepted snapshot created this activated Recovery economic right."
    }
  },
  "required": [
    "brand_id",
    "vertical",
    "node_share_percent",
    "billing_model",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
