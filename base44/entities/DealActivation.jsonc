{
  "name": "DealActivation",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "deal_application_id": {
      "type": "string"
    },
    "catalog_deal_id": {
      "type": "string"
    },
    "deal_name": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "description": "DEPRECATED: legacy provider name. Read-only."
    },
    "vertical": {
      "type": "string",
      "enum": [
        "payments",
        "shipping",
        "saas"
      ]
    },
    "provider_from": {
      "type": "string"
    },
    "provider_to": {
      "type": "string"
    },
    "projected_savings_monthly": {
      "type": "number"
    },
    "projected_savings_annual": {
      "type": "number"
    },
    "estimated_savings_yearly": {
      "type": "number"
    },
    "activated_savings_yearly": {
      "type": "number"
    },
    "potential_savings_yearly": {
      "type": "number"
    },
    "realized_savings_monthly": {
      "type": "number"
    },
    "realized_savings_yearly": {
      "type": "number"
    },
    "node_share_percent": {
      "type": "number",
      "default": 25
    },
    "billing_model": {
      "type": "string",
      "enum": [
        "monthly_success_fee"
      ],
      "default": "monthly_success_fee"
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "proposed",
        "activated",
        "awaiting_authorization",
        "authorized",
        "migrating",
        "live",
        "monetizing",
        "paused",
        "revoked",
        "closed"
      ],
      "default": "proposed"
    },
    "realization_mode": {
      "type": "string",
      "enum": [
        "verified",
        "simulated",
        "hybrid"
      ],
      "default": "simulated"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "brand_id",
    "vertical",
    "node_share_percent",
    "billing_model",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}