{
  "name": "AnalyzerResult",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "input_id": {
      "type": "string"
    },
    "payment_savings": {
      "type": "number"
    },
    "shipping_savings": {
      "type": "number"
    },
    "saas_savings": {
      "type": "number"
    },
    "total_savings": {
      "type": "number"
    },
    "infra_score": {
      "type": "number",
      "description": "Infrastructure score 0-100"
    },
    "payment_benchmark": {
      "type": "number"
    },
    "shipping_benchmark": {
      "type": "number"
    },
    "saas_benchmark": {
      "type": "number"
    },
    "details": {
      "type": "object",
      "properties": {
        "payment_current_rate": {
          "type": "number"
        },
        "payment_optimal_rate": {
          "type": "number"
        },
        "shipping_current_avg": {
          "type": "number"
        },
        "shipping_optimal_avg": {
          "type": "number"
        },
        "saas_current_total": {
          "type": "number"
        },
        "saas_optimal_total": {
          "type": "number"
        }
      }
    },
    "confidence_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "description": "Credibility of the estimate"
    },
    "data_completeness_score": {
      "type": "number",
      "description": "0-100 \u2014 % of fields populated with real data"
    },
    "methodology": {
      "type": "string",
      "description": "Short description of how savings were computed"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Assumptions applied during estimation"
    },
    "benchmark_source": {
      "type": "string",
      "enum": [
        "network_internal",
        "industry_public",
        "provider_published",
        "hybrid"
      ],
      "default": "network_internal"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "estimated",
        "pending_verification",
        "verified"
      ],
      "default": "pending_verification",
      "description": "Estimates from manual input are never 'verified' until backed by evidence"
    },
    "next_best_action": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}