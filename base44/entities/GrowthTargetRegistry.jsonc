{
  "type": "object",
  "description": "Versioned founder-editable strategic target. Targets are plans, never forecasts or observed facts.",
  "properties": {
    "target_key": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ACTIVE",
        "SUPERSEDED",
        "ARCHIVED"
      ]
    },
    "period_key": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "metric_key": {
      "type": "string",
      "enum": [
        "BOOKINGS",
        "VERIFIED_ECONOMIC_VALUE",
        "REVENUE",
        "CASH"
      ]
    },
    "business_line": {
      "type": "string",
      "enum": [
        "ALL",
        "PAYMENTS_EUROPE",
        "PAYMENTS_USA",
        "LOGISTICS_EUROPE"
      ]
    },
    "geography": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "target_value": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "target_kind": {
      "type": "string",
      "enum": [
        "STRATEGIC_TARGET",
        "OPERATING_TARGET",
        "CAPACITY_PLAN"
      ]
    },
    "milestones_json": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_note": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "target_key",
    "version",
    "status",
    "period_key",
    "period_start",
    "period_end",
    "metric_key",
    "business_line",
    "target_value",
    "currency",
    "target_kind",
    "created_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "GrowthTargetRegistry"
}