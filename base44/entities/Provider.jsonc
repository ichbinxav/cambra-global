{
  "name": "Provider",
  "type": "object",
  "description": "Internal provider CRM (contact emails, revenue-share terms, notes). Never rendered on public surfaces (/ForProviders is static marketing) \u2014 admin-only RLS (SECURITY-1, 2026-07-24). Backend functions use service role.",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "payments",
        "shipping",
        "saas",
        "insurance",
        "banking",
        "logistics"
      ]
    },
    "contact_email": {
      "type": "string"
    },
    "account_manager": {
      "type": "string"
    },
    "api_status": {
      "type": "string",
      "enum": [
        "connected",
        "not_connected",
        "error"
      ],
      "default": "not_connected"
    },
    "contract_type": {
      "type": "string"
    },
    "revenue_share_pct": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "deal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "website": {
      "type": "string"
    },
    "contact_resolution_status": {
      "type": "string",
      "enum": [
        "unknown",
        "resolved",
        "unresolved"
      ]
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
