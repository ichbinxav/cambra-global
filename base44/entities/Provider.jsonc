{
  "name": "Provider",
  "type": "object",
  "description": "Canonical provider identity + existing internal provider CRM. P2 extends this entity; no second provider system.",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "payments",
        "shipping",
        "saas",
        "insurance",
        "banking",
        "logistics"
      ]
    },
    "contact_email": {
      "type": "string"
    },
    "account_manager": {
      "type": "string"
    },
    "api_status": {
      "type": "string",
      "enum": [
        "connected",
        "not_connected",
        "error"
      ],
      "default": "not_connected"
    },
    "contract_type": {
      "type": "string"
    },
    "revenue_share_pct": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "deal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "website": {
      "type": "string"
    },
    "contact_resolution_status": {
      "type": "string",
      "enum": [
        "unknown",
        "resolved",
        "unresolved"
      ]
    },
    "preferred_status": {
      "type": "string",
      "enum": [
        "standard",
        "preferred",
        "strategic",
        "category_leader"
      ],
      "default": "standard"
    },
    "strategic_importance": {
      "type": "number"
    },
    "aggregate_responsiveness_score": {
      "type": "number"
    },
    "aggregate_relationship_json": {
      "type": "object"
    },
    "provider_monetization_status": {
      "type": "string",
      "enum": [
        "unknown",
        "opportunity",
        "negotiating",
        "contracted",
        "active",
        "prohibited"
      ],
      "default": "unknown"
    },
    "provider_compensation_summary_json": {
      "type": "object"
    },
    "provider_economics_renewal_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_key": {
      "type": "string"
    },
    "canonical_name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trading_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provider_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ACQUIRER",
          "BANK_ACQUIRER",
          "PSP",
          "PAYMENT_FACILITATOR",
          "PAYMENT_GATEWAY",
          "TECHNICAL_PROCESSOR",
          "PAYMENT_INFRASTRUCTURE",
          "POS_PROVIDER",
          "TERMINAL_PROVIDER",
          "PAYMENT_ORCHESTRATION",
          "OPEN_BANKING_PROVIDER",
          "OTHER_PAYMENT_INFRASTRUCTURE"
        ]
      }
    },
    "commercial_category": {
      "type": "string"
    },
    "regulatory_role": {
      "type": "string"
    },
    "regulated_entity": {
      "type": "boolean"
    },
    "regulator": {
      "type": "string"
    },
    "regulatory_reference": {
      "type": "string"
    },
    "corporate_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "LIMITED",
        "ACQUIRED",
        "REBRANDED",
        "INACTIVE",
        "UNKNOWN"
      ]
    },
    "parent_provider_id": {
      "type": "string"
    },
    "official_website": {
      "type": "string"
    },
    "significance": {
      "type": "string",
      "enum": [
        "MAJOR",
        "SIGNIFICANT",
        "LOCAL",
        "NICHE",
        "UNKNOWN"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "confidence_band": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "p2_status": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "VERIFIED",
        "REJECTED",
        "DUPLICATE",
        "RELATED_ENTITY",
        "INACTIVE",
        "UNRESOLVED"
      ]
    }
  },
  "required": [
    "name",
    "category"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
