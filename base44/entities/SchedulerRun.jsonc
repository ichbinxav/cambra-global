{
  "name": "SchedulerRun",
  "type": "object",
  "description": "Runtime heartbeat, durable lease authority and duplicate-execution guard for Base44 workers. CONTROL rows serialize scheduled, manual and internal triggers; ATTEMPT rows preserve immutable execution evidence.",
  "properties": {
    "record_kind": { "type": "string", "enum": ["CONTROL", "ATTEMPT"], "default": "ATTEMPT" },
    "control_key": { "type": "string", "description": "Stable scheduler authority key (one exact row per worker)." },
    "control_state": { "type": "string", "enum": ["IDLE", "CLAIMED", "RUNNING", "REVIEW_REQUIRED"], "default": "IDLE" },
    "control_revision": { "type": "number", "default": 0, "description": "Monotonic CAS fencing revision." },
    "control_token": { "type": "string" },
    "control_owner": { "type": "string" },
    "control_claimed_at": { "type": "string", "format": "date-time" },
    "control_expires_at": { "type": "string", "format": "date-time" },
    "control_effects_started": { "type": "boolean", "default": false },
    "active_attempt_id": { "type": "string" },
    "active_run_key": { "type": "string" },
    "active_operation_key": { "type": "string", "description": "Operation identity held by the current fenced owner." },
    "active_effect_key": { "type": "string", "description": "Effect identity held by the current fenced owner." },
    "last_terminal_scheduled_key": { "type": "string" },
    "last_terminal_logical_trigger_key": { "type": "string" },
    "last_terminal_operation_key": { "type": "string", "description": "Last terminal durable operation identity shared by scheduled, manual and internal triggers." },
    "last_terminal_effect_key": { "type": "string", "description": "Effect identity associated with the last terminal operation." },
    "last_terminal_status": { "type": "string" },
    "logical_trigger_key": { "type": "string" },
    "operation_key": { "type": "string", "description": "Durable logical operation identity shared across trigger types." },
    "effect_key": { "type": "string", "description": "Stable downstream material-effect identity; not a second claim authority." },
    "attempt_token": { "type": "string" },
    "claim_acquired": { "type": "boolean", "default": false, "description": "True only for ATTEMPT rows that won the CONTROL CAS; blocked observations are false." },
    "attempt_fence_revision": { "type": "number", "default": 0 },
    "lease_expires_at": { "type": "string", "format": "date-time" },
    "effects_started": { "type": "boolean", "default": false },
    "run_key": { "type": "string" },
    "worker_key": { "type": "string" },
    "slot_started_at": { "type": "string", "format": "date-time" },
    "cadence_seconds": { "type": "number", "minimum": 300 },
    "automation_id": { "type": "string" },
    "invocation_kind": { "type": "string", "enum": ["SCHEDULED", "MANUAL", "INTERNAL"] },
    "status": { "type": "string", "enum": ["CLAIMED", "RUNNING", "COMPLETED", "FAILED", "EXPIRED_PRE_EFFECT", "DUPLICATE_BLOCKED", "REVIEW_REQUIRED"] },
    "material_effect_state": { "type": "string", "enum": ["CLAIMED", "EFFECT_STARTED", "EXECUTED", "FAILED_PRE_EFFECT", "FAILED_POST_EFFECT", "REVIEW_REQUIRED", "RELEASED", "EXPIRED_PRE_EFFECT"], "description": "Projection onto material-effect-contract-v1; SchedulerRun remains the durable authority." },
    "duplicate_of": { "type": "string" },
    "details_json": { "type": "object" },
    "started_at": { "type": "string", "format": "date-time" },
    "heartbeat_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" }
  },
  "required": ["run_key", "worker_key", "cadence_seconds", "invocation_kind", "status", "started_at"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "write": { "user_condition": { "role": "__service_role_only__" } }
  }
}
