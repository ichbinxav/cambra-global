{
  "name": "StatementImport",
  "type": "object",
  "description": "ECL evidence-import record. The optional lifecycle fields remain owned by the canonical ECL engine. As of document-extraction-2.0.0, processUploadedFile writes only parse/extraction provenance and still does not assign lifecycle status, confidence results, billing eligibility or financial truth.",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "vertical": {
      "type": "string",
      "enum": [
        "payments",
        "shipping",
        "saas"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "parser": {
      "type": "string",
      "enum": [
        "csv",
        "xlsx",
        "api",
        "json",
        "pdf",
        "image",
        "other"
      ],
      "default": "csv",
      "description": "How the file was parsed. New accepted writes support signature-validated PDF/image/CSV/JSON; xls/xlsx/other remain legacy enum values and are rejected by document-extraction-2.0.0 until a verified parser exists."
    },
    "parsed_status": {
      "type": "string",
      "enum": [
        "pending",
        "success",
        "error",
        "format_unknown",
        "needs_review"
      ],
      "default": "pending",
      "description": "`format_unknown` = layered extractor could not recognize the document as a supported invoice type; NO numbers were persisted. `needs_review` = layered extractor produced a result but at least one field failed cross-validation and is being flagged rather than silently accepted."
    },
    "row_count": {
      "type": "number"
    },
    "checksum": {
      "type": "string"
    },
    "mapping_name": {
      "type": "string"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "extraction_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unverified"
      ],
      "description": "Parse-layer confidence only. For document-extraction-2.0.0, `high` requires normalized agreement between independent Claude and OpenAI reads plus deterministic unit/date/currency/semantic validation. One-reader or disagreement results are `low` and never projected; no-reader is `unverified`. `medium` remains for legacy records. This is distinct from ECL confidence and never authorizes billing."
    },
    "provider_detected": {
      "type": "string",
      "description": "Provider inferred from the document (e.g. 'stripe', 'shopify_payments', 'sumup'). Empty string when unknown \u2014 never fill with a guess."
    },
    "metadata_json": {
      "type": "object",
      "description": "Structured, minimized extraction audit. v2 stores file hash/type/size, model identities and availability, deterministic problems/disagreements, accepted canonical minor-unit fields, projection eligibility and aggregates. It stores neither file bytes nor raw model responses.",
      "properties": {
        "extraction_version": { "type": "string" },
        "file": { "type": "object" },
        "model_verdicts": { "type": "object" },
        "comparison": { "type": "object" },
        "canonical": { "type": "object" },
        "projection": { "type": "object" },
        "aggregates": { "type": "object" },
        "layer1": {
          "type": "object",
          "description": "Legacy metadata shape only. document-extraction-2.0.0 never writes raw model output."
        },
        "layer2": {
          "type": "object",
          "description": "Legacy metadata shape only. v2 writes deterministic problems into comparison instead."
        },
        "layer3": {
          "type": "object",
          "description": "Legacy metadata shape only. v2 writes minimized provider verdicts and disagreements without raw responses."
        },
        "fields": {
          "type": "object",
          "description": "Legacy metadata shape only. v2 accepted fields live under canonical in integer minor units."
        },
        "format_detected": {
          "type": "string"
        },
        "llm_enabled": {
          "type": "boolean",
          "description": "Legacy gate marker. v2 provider availability is represented by minimized model_verdicts."
        }
      }
    },
    "owner_email": {
      "type": "string",
      "description": "ECL P1 \u2014 email of the merchant this import belongs to, resolved SERVER-SIDE from the authenticated session by a future writer, never from a payload. Exists because created_by alone cannot express ownership for records produced by service-role jobs. Optional: legacy rows have no value and RLS keeps relying on created_by, which is why the existing RLS below is unchanged."
    },
    "confidence_result": {
      "type": "object",
      "description": "ECL P1 \u2014 STRUCTURED (never a JSON string) snapshot of the confidence evaluation that a later phase will produce for this import. Empty in P1: no evaluator exists yet. Persisted as an object so it can be queried and diffed instead of parsed."
    },
    "confidence_result_hash": {
      "type": "string",
      "description": "ECL P1 \u2014 SHA-256 of the stable serialization of confidence_result, so a stored evaluation can be proven to be the one that was actually computed. Written together with confidence_result or not at all."
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "estimated",
        "accepted_provisionally",
        "verified",
        "rejected",
        "expired",
        "superseded",
        "under_review"
      ],
      "description": "ECL P1 \u2014 evidence-lifecycle state of this import. DELIBERATELY DISTINCT FROM parsed_status: parsed_status describes whether the FILE could be read, this describes whether the EVIDENCE can be relied upon. No default and not required: a legacy row carries no lifecycle state, and inventing 'pending' for it would claim a lifecycle that never ran. No transition logic exists in P1."
    },
    "provisional_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ECL P1 \u2014 instant the evidence entered 'accepted_provisionally'. Anchors the provisional window; the window itself is enforced by a later phase, not here."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "ECL P1 \u2014 instant the provisional acceptance stops being valid. Storage only in P1: nothing reads it, no scheduler exists."
    },
    "next_lifecycle_action_at": {
      "type": "string",
      "format": "date-time",
      "description": "ECL P1 \u2014 when the next lifecycle action (reminder, expiry, review) would be due. A future scheduler will read it; P1 ships no scheduler and no automation."
    },
    "reminder_count": {
      "type": "number",
      "default": 0,
      "description": "ECL P1 \u2014 how many merchant reminders were sent for this evidence. Defaults to 0 (a count of zero is factually true for every existing row, unlike a status)."
    },
    "superseded_by_id": {
      "type": "string",
      "description": "ECL P1 \u2014 id of the StatementImport that replaced this one. Corrections create a NEW record and point the old one here; nothing is ever rewritten in place."
    }
  },
  "required": [
    "file_url",
    "parser",
    "parsed_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
