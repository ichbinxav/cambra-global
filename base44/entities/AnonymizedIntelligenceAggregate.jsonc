{
  "name": "AnonymizedIntelligenceAggregate",
  "type": "object",
  "description": "Append-only cross-tenant retained intelligence containing only irreversible/coarsened aggregates. No merchant identifier, stable pseudonym, contact, document/thread ID or reidentification mapping may be stored here.",
  "properties": {
    "aggregate_key": { "type": "string" },
    "aggregate_series_key": {
      "type": "string",
      "description": "Stable privacy-safe cohort identity. Snapshot records append to this series and never replace prior source history."
    },
    "aggregate_snapshot_version": { "type": "string" },
    "supersedes_aggregate_id": { "type": "string" },
    "aggregate_type": {
      "type": "string",
      "enum": ["benchmark", "verified_outcomes"]
    },
    "vertical": { "type": "string" },
    "provider_bucket": { "type": "string" },
    "country_bucket": { "type": "string" },
    "cohort_bucket": { "type": "string" },
    "currency_bucket": {
      "type": "string",
      "description": "Explicit native currency for financial outcome cohorts. UNKNOWN currency is never publishable as a financial aggregate."
    },
    "period": { "type": "string" },
    "sample_size": { "type": "number", "minimum": 10 },
    "metrics_json": { "type": "object" },
    "source_coverage_json": { "type": "object" },
    "anonymization_method": { "type": "string" },
    "anonymization_version": { "type": "string" },
    "reidentification_mapping_retained": {
      "type": "boolean",
      "const": false
    },
    "last_verified_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "aggregate_key",
    "aggregate_type",
    "sample_size",
    "metrics_json",
    "anonymization_method",
    "anonymization_version",
    "reidentification_mapping_retained",
    "last_verified_at"
  ],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "write": { "user_condition": { "role": "admin" } }
  }
}
