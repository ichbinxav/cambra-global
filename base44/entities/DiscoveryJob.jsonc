{
  "name": "DiscoveryJob",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "email_domain": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "partial"
      ],
      "default": "queued"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error_message": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "findings_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "brand_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}