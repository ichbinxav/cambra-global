{
  "name": "ApiActivityLog",
  "type": "object",
  "properties": {
    "observation_key": {
      "type": "string",
      "description": "Server-generated identity of one durable SLO observation. Missing means a legacy API log, never an SLO sample."
    },
    "observation_version": {
      "type": "string"
    },
    "observation_state": {
      "type": "string",
      "enum": ["STARTED", "SUCCEEDED", "FAILED", "EXCLUDED"]
    },
    "slo_key": {
      "type": "string"
    },
    "workload_key": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_identity_hash": {
      "type": "string"
    },
    "runtime_git_sha": {
      "type": "string"
    },
    "api_key_id": {
      "type": "string"
    },
    "api_key_name": {
      "type": "string"
    },
    "key_prefix": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "endpoint": {
      "type": "string",
      "description": "e.g. GET /brands, POST /analysis/run"
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PATCH",
        "PUT",
        "DELETE"
      ]
    },
    "scope_used": {
      "type": "string"
    },
    "status_code": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "error",
        "unauthorized",
        "forbidden",
        "not_found"
      ],
      "default": "success"
    },
    "ip_address": {
      "type": "string",
      "description": "Legacy deprecated field. New writes MUST leave it unset; raw network addresses are prohibited."
    },
    "network_fingerprint": {
      "type": "string",
      "description": "Versioned, domain-separated HMAC fingerprint. Cannot contain a raw network address or proxy header."
    },
    "network_fingerprint_version": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "duration_ms": {
      "type": "number"
    },
    "request_id": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "payload_summary": {
      "type": "object",
      "description": "Sanitized summary of request (no secrets)"
    }
  },
  "required": [
    "endpoint",
    "method",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}
