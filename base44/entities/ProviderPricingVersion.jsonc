{
  "name": "ProviderPricingVersion",
  "type": "object",
  "description": "P12 bitemporal provider pricing ledger. Historical versions are append-only; active/current is resolved by time and state.",
  "properties": {
    "pricing_key": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_slug": {
      "type": "string"
    },
    "product_key": {
      "type": "string"
    },
    "vertical": {
      "type": "string",
      "default": "payments"
    },
    "channel": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "pricing_dimension": {
      "type": "string"
    },
    "rate_type": {
      "type": "string"
    },
    "variable_rate_bps": {
      "type": "number"
    },
    "fixed_fee_minor": {
      "type": "number"
    },
    "monthly_fee_minor": {
      "type": "number"
    },
    "conditions_json": {
      "type": "object"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "truth_level": {
      "type": "string",
      "enum": [
        "verified_official",
        "observed",
        "inferred"
      ]
    },
    "knowledge_state": {
      "type": "string",
      "enum": [
        "candidate",
        "observed",
        "corroborated",
        "verified",
        "active",
        "stale",
        "superseded",
        "archived",
        "quarantined"
      ]
    },
    "source_evidence_id": {
      "type": "string"
    },
    "source_reference": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "confidence": {
      "type": "number"
    },
    "version": {
      "type": "number"
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "pricing_key",
    "provider_slug",
    "vertical",
    "pricing_dimension",
    "truth_level",
    "knowledge_state",
    "effective_at",
    "observed_at",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
