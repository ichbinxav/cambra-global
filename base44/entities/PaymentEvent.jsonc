{
  "name": "PaymentEvent",
  "type": "object",
  "description": "Append-only ledger of invoice-linked payment lifecycle events. RECOVER-4 (2026-08-04) added processor_event_id/event_hash for Stripe webhook idempotency (one logical PaymentEvent per Stripe event) and extended the enum ADDITIVELY (existing values untouched). Never stores raw Stripe payloads, bank data, PANs, IBANs or secrets \u2014 only sanitized codes and references.",
  "properties": {
    "invoice_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "invoice_issued",
        "invoice_sent",
        "payment_link_created",
        "payment_succeeded",
        "payment_partially_succeeded",
        "payment_failed",
        "refund_issued",
        "status_overridden",
        "marked_overdue",
        "payment_processing",
        "payment_action_required",
        "invoice_voided",
        "dispute_created",
        "credit_note_created",
        "reconciliation_corrected",
        "reconciliation_observed",
        "reconciliation_mismatch",
        "provider_effect_started",
        "provider_effect_observed",
        "provider_effect_failed_pre_effect",
        "saga_review_required"
      ]
    },
    "processor": {
      "type": "string"
    },
    "processor_ref": {
      "type": "string"
    },
    "processor_event_id": {
      "type": "string",
      "description": "RECOVER-4 \u2014 Stripe event.id that produced this row. Uniqueness is enforced logically by the webhook handler (skip if a row with this id already exists)."
    },
    "event_hash": {
      "type": "string",
      "description": "RECOVER-4 \u2014 hash of (event id + type + invoice) for defensive dedup when the processor id is absent."
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "metadata_json": {
      "type": "object"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "invoice_id",
    "event_type",
    "occurred_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}
