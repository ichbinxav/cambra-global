{
  "name": "BrandSavings",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "result_id": {
      "type": "string"
    },
    "estimated_current_cost_monthly": {
      "type": "number"
    },
    "estimated_optimized_cost_monthly": {
      "type": "number"
    },
    "estimated_savings_monthly": {
      "type": "number"
    },
    "estimated_savings_yearly": {
      "type": "number"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "brand_id",
    "result_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}