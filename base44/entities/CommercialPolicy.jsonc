{
  "name": "CommercialPolicy",
  "type": "object",
  "description": "Versioned founder-approved autonomy policy. Defines what CAMBRA may do automatically; never stores accepted Recover economics.",
  "properties": {
    "policy_key": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "engine": {
      "type": "string",
      "enum": [
        "merchant_acquisition",
        "partner_acquisition",
        "provider_negotiation",
        "aggregate_procurement",
        "merchant_operations"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "superseded",
        "paused"
      ],
      "default": "draft"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "icp_json": {
      "type": "object",
      "description": "Founder-approved acquisition ICP snapshot (industry, titles, countries, per-run discovery cap). Ignored by provider-negotiation policies."
    },
    "excluded_domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Domains that autonomous acquisition must never contact."
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "en",
          "fr",
          "es"
        ]
      }
    },
    "daily_send_limit": {
      "type": "number"
    },
    "min_lead_score": {
      "type": "number"
    },
    "business_hours_start": {
      "type": "number"
    },
    "business_hours_end": {
      "type": "number"
    },
    "max_followups": {
      "type": "number"
    },
    "followup_intervals_hours": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "allowed_routine_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prohibited_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "identity_label": {
      "type": "string"
    },
    "style_policy_version": {
      "type": "string"
    },
    "claims_policy_json": {
      "type": "object"
    },
    "approval_snapshot_json": {
      "type": "object"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "fallback_timezone": {
      "type": "string"
    },
    "minimum_inbound_reply_delay_minutes": {
      "type": "number"
    }
  },
  "required": [
    "policy_key",
    "version",
    "engine",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}