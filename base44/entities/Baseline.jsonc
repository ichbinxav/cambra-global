{
  "name": "Baseline",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "deal_id": {
      "type": "string",
      "description": "DEPRECATED: legacy. Read-only."
    },
    "deal_activation_id": {
      "type": "string",
      "description": "Canonical: references DealActivation.id"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "catalog_deal_id": {
      "type": "string"
    },
    "vertical": {
      "type": "string",
      "enum": [
        "payments",
        "shipping",
        "saas"
      ]
    },
    "baseline_type": {
      "type": "string",
      "enum": [
        "rate",
        "cost"
      ]
    },
    "baseline_value": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "snapshot_json": {
      "type": "object"
    },
    "source": {
      "type": "string",
      "enum": [
        "api",
        "upload",
        "manual"
      ],
      "default": "manual"
    },
    "locked": {
      "type": "boolean",
      "default": true
    },
    "locked_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "string"
    },
    "is_current": {
      "type": "boolean",
      "default": true
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "metric_name": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "methodology": {
      "type": "string"
    },
    "confidence_score": {
      "type": "number"
    },
    "verified_by": {
      "type": "string"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_id": {
      "type": "string"
    }
  },
  "required": [
    "vertical",
    "baseline_type",
    "baseline_value",
    "locked",
    "locked_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}