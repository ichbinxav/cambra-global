{
  "name": "OperationalLog",
  "type": "object",
  "properties": {
    "deal_activation_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "description": "Open event namespace for immutable operational audit. Producers use documented snake_case names; a stale enum must never cause silent audit loss."
    },
    "message": {
      "type": "string"
    },
    "data_json": {
      "type": "object"
    },
    "actor_email": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_type",
    "created_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}
