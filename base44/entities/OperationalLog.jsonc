{
  "name": "OperationalLog",
  "type": "object",
  "properties": {
    "deal_activation_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "activation_created",
        "baseline_frozen",
        "mandate_signed",
        "mandate_revoked",
        "tasks_generated",
        "task_updated",
        "status_changed",
        "go_live",
        "override_applied",
        "quarantine_probe"
      ],
      "description": "PURGE-2 (2026-07-24): 'quarantine_probe' added \u2014 written by the invocation probe injected at the top of every [QUARANTINE 2026-08-15] function. A row here means someone actually invoked a function the static census classified as orphan; review these rows before the second purge sweep."
    },
    "message": {
      "type": "string"
    },
    "data_json": {
      "type": "object"
    },
    "actor_email": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "event_type",
    "created_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}