{
  "name": "Insight",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "content": {
      "type": "string",
      "description": "Full article content in markdown"
    },
    "category": {
      "type": "string",
      "enum": [
        "payments",
        "margins",
        "scaling",
        "infrastructure"
      ]
    },
    "cover_image": {
      "type": "string"
    },
    "read_time": {
      "type": "number"
    },
    "published": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "title"
  ]
}