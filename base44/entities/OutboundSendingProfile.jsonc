{
  "name": "OutboundSendingProfile",
  "type": "object",
  "description": "Admin-only deliverability and capacity policy for CAMBRA outbound infrastructure. Limits are safety ceilings, not provider-limit bypasses.",
  "properties": {
    "profile_key": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "enum": [
        "outlook",
        "resend",
        "instantly"
      ]
    },
    "domain": {
      "type": "string"
    },
    "dkim_selectors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit DKIM selectors that the real-runtime deliverability verifier must resolve. Missing selectors block GO."
    },
    "from_address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "warming",
        "active",
        "paused"
      ],
      "default": "warming"
    },
    "current_daily_cap": {
      "type": "number"
    },
    "target_daily_cap": {
      "type": "number"
    },
    "ramp_step": {
      "type": "number"
    },
    "ramp_min_days": {
      "type": "number"
    },
    "bounce_pause_threshold_pct": {
      "type": "number"
    },
    "complaint_pause_threshold_pct": {
      "type": "number"
    },
    "complaint_slow_threshold_pct": {
      "type": "number"
    },
    "open_tracking": {
      "type": "boolean"
    },
    "click_tracking": {
      "type": "boolean"
    },
    "last_review_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_ramp_at": {
      "type": "string",
      "format": "date-time"
    },
    "healthy_days": {
      "type": "number"
    },
    "sent_window": {
      "type": "number"
    },
    "bounced_window": {
      "type": "number"
    },
    "complained_window": {
      "type": "number"
    },
    "bounce_rate_pct": {
      "type": "number"
    },
    "complaint_rate_pct": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "burst_per_minute": {
      "type": "number",
      "description": "All-message burst ceiling per sending profile. Separate from acquisition daily cap so legitimate replies are not charged against new-contact capacity."
    },
    "external_campaign_id": {
      "type": "string",
      "description": "Provider campaign reference only. CAMBRA remains the canonical owner of lead, strategy, message and conversation state."
    },
    "provider_config_json": {
      "type": "object",
      "description": "Non-secret adapter configuration such as account emails, campaign template revision and feature flags."
    },
    "webhook_status": {
      "type": "string",
      "enum": ["NOT_CONFIGURED", "CONFIGURED", "ACTIVE", "DEGRADED", "ERROR"]
    },
    "last_provider_health_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "profile_key",
    "provider",
    "domain",
    "status",
    "current_daily_cap",
    "target_daily_cap"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
