{
  "name": "AgentQuestion",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string",
      "description": "Tenant isolation key. Every AgentQuestion belongs to exactly one Brand."
    },
    "agent_task_id": {
      "type": "string",
      "description": "FK \u2192 AgentTask. The task that is blocked waiting for this answer."
    },
    "agent_name": {
      "type": "string",
      "description": "Name of the agent that raised the question (e.g. 'lead_discovery', 'outreach')."
    },
    "question_text": {
      "type": "string",
      "description": "The question itself, in plain text, addressed to the founder."
    },
    "question_type": {
      "type": "string",
      "enum": [
        "choice",
        "text",
        "access"
      ],
      "default": "text",
      "description": "choice = pick one option \u00b7 text = free-form short reply \u00b7 access = founder needs to grant access / set a secret"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Only used when question_type='choice'."
    },
    "context_summary": {
      "type": "string",
      "description": "Optional 1-2 line context shown above the question."
    },
    "access_link": {
      "type": "string",
      "description": "Only used when question_type='access' \u2014 where the founder goes to grant access (e.g. /admin/integrations or a settings url)."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "answered",
        "cancelled",
        "expired"
      ],
      "default": "pending"
    },
    "answer_text": {
      "type": "string",
      "description": "The founder's answer (free-form, or the chosen option label, or 'granted'/'declined' for access)."
    },
    "answered_by": {
      "type": "string",
      "description": "Email of the founder who answered."
    },
    "answered_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "brand_id",
    "agent_task_id",
    "agent_name",
    "question_text",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}