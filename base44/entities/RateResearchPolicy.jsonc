{
  "name": "RateResearchPolicy",
  "type": "object",
  "description": "P3 versioned research/watch/autopromotion policy.",
  "properties": {
    "policy_key": {
      "type": "string"
    },
    "market": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_slug": {
      "type": "string"
    },
    "provider_product_id": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "HIGH",
        "NORMAL",
        "LOW"
      ]
    },
    "cadence_hours": {
      "type": "number"
    },
    "freshness_sla_hours": {
      "type": "number"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auto_promotion_threshold": {
      "type": "number"
    },
    "review_required": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "policy_version": {
      "type": "string"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_run_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "policy_key",
    "provider_slug",
    "policy_version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
