{
  "name": "AnalyzerInput",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string",
      "description": "Required link to Brand"
    },
    "monthly_revenue": {
      "type": "number"
    },
    "monthly_revenue_range": {
      "type": "string",
      "enum": [
        "under_10k",
        "10k_50k",
        "50k_100k",
        "100k_500k",
        "over_500k"
      ],
      "description": "Range bucket used by the 3-step Analyzer flow"
    },
    "monthly_transactions": {
      "type": "number"
    },
    "avg_order_value": {
      "type": "number"
    },
    "channel_mix": {
      "type": "object",
      "properties": {
        "dtc_pct": {
          "type": "number"
        },
        "marketplace_pct": {
          "type": "number"
        },
        "wholesale_pct": {
          "type": "number"
        },
        "retail_pct": {
          "type": "number"
        }
      }
    },
    "dtc_pct": {
      "type": "number",
      "description": "% of sales via direct-to-consumer"
    },
    "marketplace_pct": {
      "type": "number",
      "description": "% of sales via marketplaces"
    },
    "wholesale_pct": {
      "type": "number",
      "description": "% of sales via wholesale"
    },
    "retail_pct": {
      "type": "number",
      "description": "% of sales via physical retail"
    },
    "intl_pct": {
      "type": "number",
      "description": "% of international orders"
    },
    "payment_provider": {
      "type": "string"
    },
    "payment_fee_pct": {
      "type": "number"
    },
    "shipping_provider": {
      "type": "string"
    },
    "monthly_shipping_cost": {
      "type": "number"
    },
    "monthly_shipments": {
      "type": "number"
    },
    "banking_monthly_fees": {
      "type": "number",
      "description": "Monthly banking fees declared in Step 2"
    },
    "saas_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "monthly_cost": {
            "type": "number"
          }
        }
      }
    },
    "total_saas_spend": {
      "type": "number"
    },
    "tpe_provider": {
      "type": "string",
      "description": "In-store card terminal / TPV provider"
    },
    "terminal_count": {
      "type": "number",
      "description": "Number of TPV terminals"
    },
    "monthly_terminal_rental": {
      "type": "number",
      "description": "Monthly rental fees for terminals (EUR)"
    },
    "tpe_transaction_fee_pct": {
      "type": "number",
      "description": "Per-transaction TPV fee %"
    },
    "in_store_gmv": {
      "type": "number",
      "description": "Monthly in-store GMV (EUR)"
    },
    "in_store_avg_ticket": {
      "type": "number",
      "description": "Average in-store ticket value (EUR)"
    },
    "card_mix_pct": {
      "type": "number",
      "description": "% of in-store sales paid by card"
    },
    "fixed_banking_fees": {
      "type": "number",
      "description": "Fixed monthly banking fees (EUR)"
    },
    "maintenance_fees": {
      "type": "number",
      "description": "Maintenance / extra fixed terminal fees (EUR)"
    },
    "contract_duration_months": {
      "type": "number",
      "description": "Contract duration in months (TPV / acquirer)"
    },
    "country": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "confirmed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Provider names the user confirmed in Step 2 of the frictionless Analyzer"
    },
    "dismissed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Provider names the user dismissed in Step 2 of the frictionless Analyzer"
    },
    "manually_added_tools": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "monthly_cost": {
            "type": "number"
          }
        }
      },
      "description": "Tools the user added manually in Step 2"
    },
    "data_source": {
      "type": "string",
      "enum": [
        "manual",
        "file_upload",
        "api",
        "hybrid"
      ],
      "default": "manual",
      "description": "How data was provided. Affects confidence."
    }
  },
  "required": [],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}