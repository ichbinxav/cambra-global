{
  "name": "EmergencyControl",
  "type": "object",
  "description": "P18 founder emergency control state. A singleton global row gates new external communications, negotiations, migrations and new billing issuance while preserving monitoring, reconciliation, audit and evidence.",
  "properties": {
    "control_key": {
      "type": "string"
    },
    "safe_mode": {
      "type": "boolean",
      "default": false
    },
    "communications_paused": {
      "type": "boolean",
      "default": false
    },
    "negotiations_paused": {
      "type": "boolean",
      "default": false
    },
    "migrations_paused": {
      "type": "boolean",
      "default": false
    },
    "billing_issuance_paused": {
      "type": "boolean",
      "default": false
    },
    "paid_discovery_paused": {
      "type": "boolean",
      "default": false,
      "description": "Founder Control V2 gate for paid Discovery and enrichment. Local/read-only intelligence may continue."
    },
    "resume_check_required": {
      "type": "boolean",
      "default": false,
      "description": "Durable marker set by emergency containment and cleared only by a dependency-aware selective Safe Resume."
    },
    "last_correlation_id": {
      "type": "string"
    },
    "control_revision": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Optimistic-CAS revision preventing concurrent stop/resume transitions from overwriting one another."
    },
    "reason": {
      "type": "string"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string"
    },
    "previous_state_json": {
      "type": "object"
    },
    "transport_containment_json": {
      "type": "object",
      "description": "Durable ROOT-OTR-003 evidence keyed by outlook/resend/instantly. Each configured transport uses exactly NOT_CONFIGURED, LOCALLY_BLOCKED, REMOTELY_VERIFIED_PAUSED, UNVERIFIED or ERROR; local blocking never impersonates a remote provider receipt."
    },
    "transport_containment_status": {
      "type": "string",
      "enum": ["CONTAINED", "CONTAINMENT_INCOMPLETE"],
      "description": "CONTAINED only when every configured transport has local blocking plus a provider pause receipt under the current strict drill contract."
    },
    "transport_containment_observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "control_key",
    "safe_mode"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
