{"name":"AcquisitionAttribution","type":"object","description":"Deterministic provenance from an outbound acquisition lead to the merchant Brand it produced. No fuzzy attribution is allowed for economic learning.","properties":{"lead_id":{"type":"string"},"brand_id":{"type":"string"},"thread_id":{"type":"string"},"contact_email":{"type":"string"},"company_domain":{"type":"string"},"attribution_method":{"type":"string","enum":["exact_contact_email"]},"confidence":{"type":"string","enum":["deterministic"]},"attributed_at":{"type":"string","format":"date-time"},"source_event":{"type":"string"}},"required":["lead_id","brand_id","attribution_method","confidence","attributed_at"],"rls":{"read":{"user_condition":{"role":"admin"}},"write":{"user_condition":{"role":"admin"}}}}