{
  "name": "ConnectionTask",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "integration_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string",
      "enum": [
        "oauth_redirect",
        "api_key_entry",
        "file_upload",
        "manual_input",
        "verification"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed",
        "skipped"
      ],
      "default": "pending"
    },
    "order": {
      "type": "number"
    },
    "result_json": {
      "type": "object"
    }
  },
  "required": [
    "session_id",
    "brand_id",
    "integration_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}