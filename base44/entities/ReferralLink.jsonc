{
  "name": "ReferralLink",
  "type": "object",
  "description": "GROWTH-1 T2 (2026-08-01) \u2014 one opaque invite code per business. Created lazily by getMyReferralLink (service role) the first time an authenticated merchant asks for their invite link. The code is a RANDOM token (crypto RNG) \u2014 deliberately NOT derivable from the email or the brand id, so a code leaks nothing about its owner. times_used is incremented server-side by submitPaymentsAnalysis whenever an analysis arrives carrying this code (attribution measurement only \u2014 NO reward mechanics in this chunk, by design: first observe whether people invite, then design the incentive with data).",
  "properties": {
    "code": {
      "type": "string",
      "description": "Opaque random invite code (10 chars, crypto RNG, [a-z0-9]). Appears in invite URLs as /Analyzer?ref=<code>. Never derived from email/brand id."
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the merchant who owns this invite link. One link per owner (find-or-create by owner_email in getMyReferralLink)."
    },
    "times_used": {
      "type": "number",
      "default": 0,
      "description": "How many analyses were submitted carrying this code (?ref=). Incremented best-effort by submitPaymentsAnalysis when the code matches. Conversion measurement joins PaymentsAnalysisSession.referred_by_code back to this row."
    }
  },
  "required": [
    "code",
    "owner_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.owner_email": "{{user.email}}"
        }
      ]
    }
  }
}