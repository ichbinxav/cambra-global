{
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "deal_activation_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "scanning",
        "planned",
        "awaiting_approval",
        "branching",
        "patching",
        "testing",
        "pr_open",
        "awaiting_cutover_approval",
        "cutting_over",
        "rolling_back",
        "verifying",
        "completed",
        "failed",
        "rolled_back",
        "review_required"
      ],
      "default": "queued"
    },
    "source_provider": {
      "type": "string"
    },
    "target_provider": {
      "type": "string"
    },
    "base_branch": {
      "type": "string"
    },
    "working_branch": {
      "type": "string"
    },
    "pull_request_url": {
      "type": "string"
    },
    "pull_request_number": {
      "type": "number"
    },
    "commit_sha": {
      "type": "string"
    },
    "rollback_sha": {
      "type": "string"
    },
    "detected_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migration_plan": {
      "type": "object"
    },
    "test_results": {
      "type": "object"
    },
    "verification": {
      "type": "object"
    },
    "failure": {
      "type": "object"
    },
    "approval_id": {
      "type": "string"
    },
    "cutover_approval_id": {
      "type": "string"
    },
    "lifecycle_version": {
      "type": "string",
      "description": "Version of the durable material-effect lifecycle used for apply, cutover and rollback."
    },
    "lifecycle_action": {
      "type": "string",
      "enum": [
        "",
        "apply_plan",
        "cutover",
        "rollback"
      ],
      "default": ""
    },
    "lifecycle_phase": {
      "type": "string",
      "enum": [
        "idle",
        "claimed",
        "effecting",
        "completed",
        "review_required"
      ],
      "default": "idle"
    },
    "lifecycle_revision": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Optimistic-CAS revision fencing concurrent material execution."
    },
    "lifecycle_attempt_token": {
      "type": "string"
    },
    "lifecycle_lease_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle_idempotency_key": {
      "type": "string"
    },
    "lifecycle_approval_id": {
      "type": "string"
    },
    "lifecycle_authority_hash": {
      "type": "string"
    },
    "lifecycle_binding_hash": {
      "type": "string"
    },
    "lifecycle_steps": {
      "type": "object",
      "description": "Durable before/after evidence for each external mutation. A pending step is never retried blindly."
    },
    "lifecycle_result": {
      "type": "object",
      "description": "Sanitized terminal evidence used for idempotent replay without repeating an external effect."
    },
    "lifecycle_review_reason": {
      "type": "string"
    },
    "lifecycle_review_evidence": {
      "type": "object"
    },
    "lifecycle_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_email": {
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "brand_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.created_by_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.created_by_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "DeveloperMigrationRun"
}
