      "description": "Legacy: previous ambiguous reference"
    },
    "deal_activation_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "step_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
