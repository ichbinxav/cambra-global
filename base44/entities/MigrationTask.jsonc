{
  "name": "MigrationTask",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Legacy: previous ambiguous reference"
    },
    "deal_activation_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "task_type": {
      "type": "string"
    },
    "step_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "blocked",
        "done",
        "canceled"
      ],
      "default": "pending"
    },
    "updated_at": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "owner_type": {
      "type": "string",
      "enum": [
        "brand",
        "provider",
        "admin"
      ],
      "default": "admin"
    },
    "owner_id": {
      "type": "string"
    },
    "requires_provider_input": {
      "type": "boolean",
      "default": false
    },
    "requires_brand_input": {
      "type": "boolean",
      "default": false
    },
    "requires_admin_review": {
      "type": "boolean",
      "default": false
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "blocked_reason": {
      "type": "string"
    },
    "metadata_json": {
      "type": "object"
    }
  },
  "required": [
    "step_name",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}