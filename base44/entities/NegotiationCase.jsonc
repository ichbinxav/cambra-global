{
  "name": "NegotiationCase",
  "type": "object",
  "description": "Persistent provider negotiation state for one Recover/provider pair. AI can reason and communicate inside authority_snapshot_json; material commitment remains L4.",
  "properties": {
    "recover_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_name": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "contacted",
        "awaiting_provider",
        "awaiting_cambra",
        "negotiating",
        "contract_received",
        "awaiting_final_approval",
        "approved",
        "rejected",
        "closed",
        "expired"
      ],
      "default": "draft"
    },
    "round": {
      "type": "number",
      "default": 0
    },
    "launched_by": {
      "type": "string",
      "description": "Email of the human who authorised this negotiation by pressing LAUNCH. Absent means no person originated it, and no automated caller may resume it. Enforced by shared/negotiationLaunchAuthority.ts."
    },
    "launched_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the human launch authorisation was recorded."
    },
    "currency": {
      "type": "string"
    },
    "current_economics_json": {
      "type": "object"
    },
    "target_economics_json": {
      "type": "object"
    },
    "best_offer_json": {
      "type": "object"
    },
    "authority_snapshot_json": {
      "type": "object"
    },
    "authority_hash": {
      "type": "string"
    },
    "strategy_json": {
      "type": "object"
    },
    "unresolved_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_action": {
      "type": "string"
    },
    "next_action_at": {
      "type": "string",
      "format": "date-time"
    },
    "final_approval_id": {
      "type": "string"
    },
    "approved_offer_id": {
      "type": "string"
    },
    "contract_document_id": {
      "type": "string"
    },
    "contract_match_status": {
      "type": "string",
      "enum": [
        "not_received",
        "pending_review",
        "match",
        "mismatch",
        "manual_review"
      ]
    },
    "contract_delta_json": {
      "type": "object"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "negotiation_scope": {
      "type": "string",
      "enum": [
        "individual",
        "aggregate"
      ],
      "default": "individual"
    },
    "aggregate_pool_id": {
      "type": "string"
    },
    "aggregate_rfp_id": {
      "type": "string"
    },
    "aggregate_bid_id": {
      "type": "string"
    },
    "demand_snapshot_json": {
      "type": "object",
      "description": "P14 anonymized truthful observed/addressable/committed demand snapshot. Never contains merchant identities."
    },
    "misrepresentation_guard_json": {
      "type": "object",
      "description": "P14 guardrail recording claim classes and whether any committed-volume statement has explicit commitment evidence."
    },
    "intelligence_snapshot_id": {
      "type": "string",
      "description": "P12 immutable decision-time intelligence provenance snapshot. Additive; historical rows may be null."
    }
  },
  "required": [
    "recover_id",
    "brand_id",
    "provider_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}