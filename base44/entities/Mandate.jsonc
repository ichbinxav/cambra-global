{
  "name": "Mandate",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "deal_id": {
      "type": "string",
      "description": "Legacy: previous ambiguous reference"
    },
    "deal_activation_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "catalog_deal_id": {
      "type": "string"
    },
    "scope_type": {
      "type": "string",
      "enum": [
        "general",
        "deal_specific"
      ],
      "default": "deal_specific"
    },
    "vertical": {
      "type": "string",
      "enum": [
        "payments",
        "shipping",
        "saas"
      ]
    },
    "authorized_actions_json": {
      "type": "object"
    },
    "legal_entity_name": {
      "type": "string"
    },
    "signed_by_name": {
      "type": "string"
    },
    "signed_by_email": {
      "type": "string"
    },
    "signed_by_role": {
      "type": "string"
    },
    "signed_at": {
      "type": "string",
      "format": "date-time"
    },
    "ip_address": {
      "type": "string"
    },
    "user_agent": {
      "type": "string"
    },
    "document_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_by": {
      "type": "string"
    },
    "revocation_reason": {
      "type": "string"
    },
    "signed_document_url": {
      "type": "string"
    }
  },
  "required": [
    "authorized_actions_json",
    "signed_by_name",
    "signed_by_email",
    "signed_at",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.signed_by_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}