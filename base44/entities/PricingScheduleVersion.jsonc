{
  "name": "PricingScheduleVersion",
  "type": "object",
  "description": "P3 immutable version of a logical rate schedule.",
  "properties": {
    "schedule_version_key": {
      "type": "string"
    },
    "pricing_schedule_id": {
      "type": "string"
    },
    "version": {
      "type": "number"
    },
    "source_snapshot_id": {
      "type": "string"
    },
    "semantic_fingerprint": {
      "type": "string"
    },
    "effective_from": {
      "type": "string",
      "format": "date-time"
    },
    "effective_to": {
      "type": "string",
      "format": "date-time"
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "CURRENT",
        "SUPERSEDED",
        "CONFLICT",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "schedule_version_key",
    "pricing_schedule_id",
    "version"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
