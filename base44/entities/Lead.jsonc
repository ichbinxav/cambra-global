{
  "name": "Lead",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "benchmark_opt_in": {
      "type": "boolean",
      "default": false
    },
    "consent": {
      "type": "boolean",
      "default": false
    },
    "source_page": {
      "type": "string"
    },
    "market_code": {
      "type": "string",
      "description": "Canonical ISO2 market captured at explicit waitlist consent. May be a non-launch market; used to reactivate warm demand when that market opens."
    },
    "notes": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "fr",
        "es"
      ],
      "default": "en",
      "description": "EMAIL-1 (2026-07-31) — language this lead should be emailed in. Written by submitCallRequest (which sends a merchant-facing confirmation and routes it through this value), submitWaitlistSignup and submitContactMessage (no merchant email today; captured so a future one, or a human reply, starts in the right language). Source is the ACTIVE UI language at submit time (same value as the cambra_lang key), never Accept-Language: a manual pick in the switcher wins (UX-1 T0 doctrine). Absent/unrecognized → 'en' via normalizeLocale (base44/shared/emailLocale.ts). Rows created before this date have no locale and therefore get English, which is what they were already receiving."
    },
    "anon_session_id": {
      "type": "string",
      "description": "Structured link back to the anonymous Analyzer session that produced this signup. Populated by submitWaitlistSignup when the caller provides context.session_id (the UUID v4 anon_session_id that tagged the original Brand/AnalyzerInput/AnalyzerResult triple). SINGLE SOURCE OF TRUTH for joining a Lead to its AnalyzerResult — replaces the fragile regex-parse of `notes`. Empty for landing-page-only signups (visitor hadn't run the Analyzer yet). Getters (getWaitlistAggregate) prefer this field and fall back to parsing `notes` only for leads created before this field existed."
    }
  },
  "required": [
    "email",
    "consent"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
