{
  "name": "CollectiveMember",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Contact email of the merchant joining the collective. Prefilled from the authenticated user when signed in, otherwise typed in the clickwrap modal."
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "fr",
        "es"
      ],
      "default": "en",
      "description": "EMAIL-1 (2026-07-31) \u2014 language the founding-member confirmation (and future collective correspondence) is sent in. Captured from the ACTIVE UI language when the clickwrap was submitted, never inferred from Accept-Language: the switcher choice wins (UX-1 T0 doctrine). Absent/unrecognized \u2192 'en' via normalizeLocale (base44/shared/emailLocale.ts)."
    },
    "gmv_eur_monthly": {
      "type": "number",
      "description": "Monthly GMV (EUR) carried over from the payments analysis that produced this join. Sizes the merchant's weight in the collective. Optional \u2014 absent when the join came from a context without a fresh analysis."
    },
    "provider_slug": {
      "type": "string",
      "description": "PSP/TPV provider slug from the analysis (stripe, sumup, ...). Optional. NEVER used to recommend a destination \u2014 collective sizing only."
    },
    "country": {
      "type": "string",
      "description": "ISO country from the analysis (e.g. 'FR'). Optional. Used to group collective demand by geography."
    },
    "annual_savings_eur": {
      "type": "number",
      "description": "The point annual savings figure (EUR) from the analysis that produced this join, copied verbatim. Optional \u2014 used to prioritize outreach to high-value joins."
    },
    "channel": {
      "type": "string",
      "enum": [
        "online",
        "in_store"
      ],
      "description": "Payment channel of the analysis that produced this join. Optional."
    },
    "source_session": {
      "type": "string",
      "description": "The anon_session_id (UUID v4) of the analysis that produced this join, when present. Joins the CollectiveMember back to its PaymentsAnalysisSession / AnalyzerResult. Empty for joins with no analysis context."
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-set timestamp when the member accepted the Collective Terms via the clickwrap. Presence = clickwrap acceptance recorded."
    },
    "terms_version": {
      "type": "string",
      "description": "Version tag IDENTIFYING the Collective Terms text that was accepted. Currently 'draft-v0' \u2014 an opaque historical identifier kept verbatim so existing acceptance records stay comparable; since LEGAL-2/EMAIL-1 (2026-07-31) it is NOT a statement about the document's review status, which is no longer surfaced in the UI or the confirmation email. Recorded so we can re-consent members whenever the text changes."
    },
    "status": {
      "type": "string",
      "enum": [
        "founding",
        "contacted",
        "active",
        "declined"
      ],
      "default": "founding",
      "description": "Lifecycle of the collective membership. New joins land as 'founding'."
    }
  },
  "required": [
    "email",
    "accepted_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}