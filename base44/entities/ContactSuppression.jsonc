{
  "name": "ContactSuppression",
  "type": "object",
  "description": "Global do-not-contact ledger. Autonomous outreach must fail closed against active suppressions.",
  "properties": {
    "email": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "opt_out",
        "bounce",
        "complaint",
        "not_interested",
        "wrong_person",
        "provider_blocklist",
        "legal",
        "manual",
        "customer_exclusion"
      ]
    },
    "source": {
      "type": "string"
    },
    "source_message_id": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "suppressed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    },
    "scope_type": {
      "type": "string",
      "enum": ["EMAIL", "PERSON", "COMPANY", "DOMAIN", "CAMPAIGN"],
      "default": "EMAIL"
    },
    "scope_value": { "type": "string", "description": "Normalized value the scope matches on (email, contact id, company key, domain, campaign id)." },
    "contact_id": { "type": "string" },
    "company_key": { "type": "string" },
    "domain": { "type": "string" },
    "campaign_id": { "type": "string" },
    "source_provider": { "type": "string" },
    "source_event_id": { "type": "string" },
    "legal_basis_or_policy_ref": { "type": "string" },
    "created_by": { "type": "string" }
  },
  "required": [
    "email",
    "reason",
    "active",
    "suppressed_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
