{
  "name": "ProviderRevenueInvoice",
  "type": "object",
  "description": "P15 provider-side invoice/settlement record. Separate from merchant Invoice. Supports CAMBRA-issued invoice or provider self-billing; no legal invoice number is invented by the platform.",
  "properties": {
    "invoice_key": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "agreement_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "cambra_invoice",
        "provider_self_billing",
        "other_contractual_settlement"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validation_pending",
        "issued",
        "payment_pending",
        "partially_paid",
        "paid",
        "disputed",
        "void"
      ]
    },
    "amount_minor": {
      "type": "number"
    },
    "paid_amount_minor": {
      "type": "number"
    },
    "external_invoice_number": {
      "type": "string"
    },
    "source_document_id": {
      "type": "string"
    },
    "provider_statement_id": {
      "type": "string"
    },
    "payment_ref": {
      "type": "string"
    },
    "tax_treatment_reference": {
      "type": "string"
    },
    "legal_authority_reference": {
      "type": "string"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "invoice_key",
    "provider_id",
    "agreement_id",
    "period",
    "currency",
    "mode",
    "status",
    "amount_minor",
    "updated_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
