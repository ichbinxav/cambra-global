{
  "name": "GrowthScenario",
  "type": "object",
  "description": "Founder-owned saved scenario. Scenarios are decision support, not commitments, budgets or execution authority.",
  "properties": {
    "scenario_key": { "type": "string" },
    "name": { "type": "string" },
    "scenario_type": { "type": "string", "enum": ["BASE", "INTERNAL_EXECUTION_TARGET", "BREAKOUT", "CUSTOM"] },
    "status": { "type": "string", "enum": ["DRAFT", "ACTIVE", "ARCHIVED"] },
    "changes_json": { "type": "array", "items": { "type": "object" } },
    "result_json": { "type": "object" },
    "target_version": { "type": "string" },
    "assumption_versions": { "type": "array", "items": { "type": "string" } },
    "created_by": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "required": ["scenario_key", "name", "scenario_type", "status", "changes_json", "created_by", "created_at", "updated_at"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "write": { "user_condition": { "role": "admin" } }
  }
}
