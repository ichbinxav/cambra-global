{
  "name": "SavingsEvidence",
  "type": "object",
  "description": "v62.3 ECL P1 (2026-08-06) \u2014 SCHEMA ONLY. The ECL fields below are ADDITIVE and OPTIONAL; no writer sets them yet and none of them participates in billing. confidence_level_ecl is deliberately NOT the same thing as the pre-existing numeric confidence_level, which is left untouched.",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "deal_activation_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "baseline_id": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "api",
        "file_upload",
        "provider_statement",
        "bank_statement",
        "manual"
      ]
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "invoice_pdf",
        "statement_csv",
        "api_metric",
        "rate_card",
        "contract",
        "other"
      ]
    },
    "file_url": {
      "type": "string"
    },
    "value_type": {
      "type": "string",
      "enum": [
        "gmv",
        "fees",
        "shipments",
        "rate",
        "cost",
        "other"
      ]
    },
    "before_value": {
      "type": "number"
    },
    "after_value": {
      "type": "number"
    },
    "delta_value": {
      "type": "number"
    },
    "methodology_used": {
      "type": "string"
    },
    "confidence_level": {
      "type": "number"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "accepted",
        "rejected"
      ],
      "default": "submitted"
    },
    "reviewer_email": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "checksum": {
      "type": "string"
    },
    "metadata_json": {
      "type": "object"
    },
    "owner_email": {
      "type": "string",
      "description": "ECL P1 \u2014 email of the merchant this evidence belongs to, resolved server-side from the authenticated session by a future writer, never from a payload. Optional; the existing RLS (admin / created_by) is unchanged."
    },
    "statement_import_id": {
      "type": "string",
      "description": "ECL P1 \u2014 the StatementImport this evidence was derived from, when it came from an uploaded document. Optional: API-sourced evidence has no import."
    },
    "confidence_level_ecl": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "description": "ECL P1 \u2014 CATEGORICAL evidence-confidence class from the (future) ECL evaluation. Deliberately a separate field from the pre-existing numeric confidence_level, which keeps its meaning and its writers: overloading that number would silently reinterpret historical rows. 'unknown' is an explicit outcome, never a filler for 'not evaluated' (an unevaluated row simply has no value here)."
    },
    "freeze_eligibility": {
      "type": "string",
      "enum": [
        "eligible",
        "conditionally_eligible",
        "not_eligible"
      ],
      "description": "ECL P1 \u2014 whether this evidence could support freezing a baseline figure. STORAGE ONLY in P1: no economic gate, no report and no invoice reads it. Recover Margin billing remains governed exclusively by the existing verified-savings machinery."
    },
    "rule_set_version": {
      "type": "string",
      "description": "ECL P1 \u2014 version tag of the rule set that produced confidence_level_ecl / freeze_eligibility. No rule engine exists yet; the field exists so an evaluation can never be stored without saying which rules produced it."
    },
    "confidence_result": {
      "type": "object",
      "description": "ECL P1 \u2014 STRUCTURED (never a JSON string) snapshot of the confidence evaluation: inputs, checks, outcome. Empty in P1."
    },
    "confidence_result_hash": {
      "type": "string",
      "description": "ECL P1 \u2014 SHA-256 of the stable serialization of confidence_result. Written together with it or not at all."
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "estimated",
        "accepted_provisionally",
        "verified",
        "rejected",
        "expired",
        "superseded",
        "under_review"
      ],
      "description": "ECL P4 \u2014 materialized lifecycle status for operational due queries. Canonical snapshots remain authoritative/auditable; this top-level projection lets the scheduler discover provisional SavingsEvidence without scanning JSON blobs."
    },
    "provisional_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ECL P4 \u2014 original start of a provisional SavingsEvidence window. Never renewed by scheduler replay."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "ECL P4 \u2014 fixed expiry of the original provisional window."
    },
    "next_lifecycle_action_at": {
      "type": "string",
      "format": "date-time",
      "description": "ECL P4 \u2014 next due operational action, derived by the canonical planner."
    },
    "reminder_count": {
      "type": "number",
      "default": 0,
      "description": "ECL P4 \u2014 materialized count of semantic reminder events. Reconciled from persisted reminder claims after crashes/replay."
    },
    "superseded_by_id": {
      "type": "string",
      "description": "ECL P4 \u2014 id of the SavingsEvidence record that superseded this evidence."
    }
  },
  "required": [
    "source_type",
    "evidence_type",
    "verification_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
