{
  "name": "Brand",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Brand name"
    },
    "website": {
      "type": "string",
      "description": "Brand website URL"
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact full name"
    },
    "contact_email": {
      "type": "string",
      "description": "Primary contact email"
    },
    "locale": {
      "type": "string",
      "enum": [
        "en",
        "fr",
        "es"
      ],
      "default": "en",
      "description": "EMAIL-1 (2026-07-31) \u2014 language for every merchant-facing email tied to this business: the welcome email (onBrandCreated) and the monthly savings summary (sendMonthlySavingsSummary). Both are triggered by an automation or a scheduler, so the HTTP request carries no user context \u2014 the value stored HERE is the only reliable language signal, which is why it lives on the record and not only on a transient submit payload. Written at Brand creation from the ACTIVE UI language (the same value that governs the cambra_lang key), never inferred from Accept-Language. Absent/unrecognized \u2192 'en' via normalizeLocale (base44/shared/emailLocale.ts); brands created before this date therefore keep receiving English, exactly as they already did."
    },
    "tax_id": {
      "type": "string",
      "description": "Company Tax ID / VAT / EIN (legacy free-text field, pre-RECOVER-4). The billing flow reads the RECOVER-4 structured fields below, not this."
    },
    "country": {
      "type": "string",
      "description": "Country of operation"
    },
    "category": {
      "type": "string",
      "enum": [
        "fashion",
        "beauty",
        "wellness",
        "lifestyle",
        "food_bev",
        "home",
        "tech",
        "other"
      ],
      "description": "Brand category"
    },
    "annual_revenue": {
      "type": "string",
      "enum": [
        "under_500k",
        "500k_1m",
        "1m_5m",
        "5m_20m",
        "20m_plus"
      ],
      "description": "Annual revenue range"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sales channels (canonical)"
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tech stack tools"
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Business goals"
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "size": {
      "type": "string",
      "enum": [
        "solo",
        "small",
        "medium",
        "large"
      ],
      "description": "Team size"
    },
    "logo_url": {
      "type": "string"
    },
    "bio": {
      "type": "string",
      "description": "Brand biography / description"
    },
    "instagram_url": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "twitter_url": {
      "type": "string"
    },
    "tiktok_url": {
      "type": "string"
    },
    "youtube_url": {
      "type": "string"
    },
    "accept_terms": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": false,
      "description": "Demo/fake brand for testing \u2014 never billed"
    },
    "anon_session_id": {
      "type": "string",
      "description": "Set when the Brand was created during an anonymous Analyzer session, before the user signed up. Cleared on claim. UUID v4 generated client-side, validated server-side. Never exposed to other users."
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "RECOVER-2 (2026-08-03) \u2014 id of the Stripe Customer, IN CAMBRA'S OWN BILLING ACCOUNT, that future success-fee invoices are charged to. THE CUSTOMER OBJECT LIVES ON THE BRAND, NOT ON Organization: the Organization / OrganizationMember entities are the API-platform tenancy (quotas, rate limits) and are never linked to a Brand, so the Brand is the only record that maps 1:1 to the business we bill. Written by startPaymentMethodSetup (service role) the first time a merchant sets up a payment method, and reused on every later setup so a business never accumulates duplicate Customers. NEVER a merchant-side Stripe id: the read-only OAuth connection to the merchant's own Stripe (StripeConnection) is a different relationship and nothing crosses between them. MODE-SCOPED: a Customer created in the sandbox does not exist in live, which is why stripe_billing_mode is recorded next to it on DealActivation \u2014 see that field. Populated for at most one mode at a time; switching CAMBRA to live billing means this id must be re-created, not reused."
    },
    "stripe_billing_mode": {
      "type": "string",
      "enum": [
        "test",
        "live"
      ],
      "description": "RECOVER-2 (2026-08-03) \u2014 which Stripe environment stripe_customer_id belongs to ('test' = CAMBRA's sandbox acct_1TqFip2Vr0WW305e, 'live' = acct_1TqFifJw0ka9dDf4). Exists because a Stripe Sandbox is a SEPARATE account with its own object space: a customer id from the sandbox is meaningless in live and would fail with a 'no such customer' at the worst possible moment (the first real invoice). startPaymentMethodSetup refuses to reuse a stored customer whose mode does not match the mode it is running in, and creates a fresh one instead."
    },
    "billing_legal_name": {
      "type": "string",
      "description": "RECOVER-4 (2026-08-04) \u2014 the customer's LEGAL entity name for invoicing. Structured billing identity lives on the Brand (organization = brand, same convention as Mandate.organization_id). Distinct from `name` (trading/brand name)."
    },
    "billing_address_line1": {
      "type": "string"
    },
    "billing_address_line2": {
      "type": "string"
    },
    "billing_postal_code": {
      "type": "string"
    },
    "billing_city": {
      "type": "string"
    },
    "billing_country": {
      "type": "string",
      "description": "RECOVER-4 \u2014 country of BUSINESS ESTABLISHMENT for tax purposes, ISO alpha-2. Only FR and ES are billable; anything else blocks with billing_blocked_unsupported_jurisdiction. Determined from legal/tax data \u2014 never from IP, browser language, card country or IBAN country (\u00a713)."
    },
    "vat_number": {
      "type": "string",
      "description": "RECOVER-4 \u2014 customer VAT identification as provided (e.g. FRxx\u2026, ESxx\u2026)."
    },
    "vat_number_normalized": {
      "type": "string",
      "description": "RECOVER-4 \u2014 uppercase, no spaces/dots/dashes. What VIES was queried with."
    },
    "vat_country": {
      "type": "string",
      "description": "RECOVER-4 \u2014 the 2-letter prefix of the VAT number. Must match billing_country for reverse charge."
    },
    "tax_customer_type": {
      "type": "string",
      "enum": [
        "business_taxable_person"
      ],
      "description": "RECOVER-4 \u2014 the only supported customer type. B2C is never invoiced from this flow; if B2B status cannot be demonstrated the state is billing_blocked_tax_review, not a default."
    },
    "tax_evidence_status": {
      "type": "string",
      "enum": [
        "none",
        "vat_id_provided",
        "vies_validated",
        "alternative_evidence_approved"
      ],
      "default": "none",
      "description": "RECOVER-4 \u2014 how the B2B/taxable-person condition is evidenced. 'alternative_evidence_approved' exists ONLY for an advisor-approved manual review (documented, with approver and date in tax_review notes) \u2014 never created automatically."
    },
    "tax_review_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected"
      ],
      "default": "not_required",
      "description": "RECOVER-4 \u2014 manual fiscal review state when automatic evidence (VIES) is insufficient."
    },
    "vies_status": {
      "type": "string",
      "enum": [
        "valid",
        "invalid",
        "unavailable",
        "timeout",
        "not_checked",
        "manual_review_approved",
        "manual_review_rejected"
      ],
      "default": "not_checked",
      "description": "RECOVER-4 \u2014 result of the latest VIES consultation for vat_number_normalized. 'invalid' NEVER auto-falls-back to French TVA (\u00a714): it blocks billing until corrected or manually reviewed. 'unavailable'/'timeout' block with retry \u2014 they are not 'invalid'."
    },
    "vies_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "vies_request_identifier": {
      "type": "string",
      "description": "RECOVER-4 \u2014 VIES consultation/request identifier returned by the service, kept as evidence of the check."
    },
    "vies_response_snapshot": {
      "type": "object",
      "description": "RECOVER-4 \u2014 sanitized VIES response (valid flag, name, address, request date). No secrets, kept for the invoice's vies_evidence_json."
    },
    "vies_name": {
      "type": "string"
    },
    "vies_address": {
      "type": "string"
    },
    "service_status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled"
      ],
      "default": "active",
      "description": "CAMBRA service relationship. Separate from per-Recover economic rights."
    },
    "service_cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the merchant cancelled the general CAMBRA service. Does not by itself terminate activated Recover V2 economic terms."
    },
    "service_cancellation_reason": {
      "type": "string",
      "description": "Optional merchant-provided cancellation reason; operational only."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.contact_email": "{{user.email}}"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
