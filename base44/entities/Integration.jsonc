{
  "name": "Integration",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string",
      "description": "Tenant isolation key. Every Integration belongs to exactly one Brand."
    },
    "provider": {
      "type": "string",
      "description": "Stable provider slug, matches a key in functions/integrationRegistry.js (e.g. 'demo_provider', 'stripe', 'shopify'). Source of truth for which OAuth or API-key config to use."
    },
    "category": {
      "type": "string",
      "description": "Cached from the registry at connection time (e.g. 'payments', 'shipping'). Denormalized so the UI can group without re-joining."
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "available",
        "connecting",
        "connected",
        "error",
        "disconnected"
      ],
      "default": "connecting"
    },
    "access_token": {
      "type": "string",
      "description": "DEPRECATED legacy migration source. New writes MUST use server-only IntegrationCredential.encrypted_access_token. Cleared only after credential persistence/readback succeeds."
    },
    "refresh_token": {
      "type": "string",
      "description": "DEPRECATED legacy migration source. New writes MUST use server-only IntegrationCredential.encrypted_refresh_token."
    },
    "access_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "never"
      ],
      "default": "never"
    },
    "last_error": {
      "type": "string",
      "description": "Most recent error message from sync or refresh."
    },
    "provider_account_id": {
      "type": "string",
      "description": "External account id returned by the provider after OAuth (for display + dedup). Null for api_key providers that don't expose an account id."
    },
    "provider_capability_risk_status": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "DEGRADED",
        "DEAUTHORIZED",
        "REVIEW_REQUIRED"
      ],
      "default": "UNKNOWN",
      "description": "Fail-closed provider capability projection. Stripe account.updated may move this to DEGRADED and deauthorization to DEAUTHORIZED; a later positive webhook never auto-reactivates it."
    },
    "provider_charges_enabled": {
      "type": "boolean",
      "description": "Last risk-relevant Stripe charges_enabled observation. False is sticky until an explicit governed reconnect/review; positive webhooks do not auto-reactivate."
    },
    "provider_payouts_enabled": {
      "type": "boolean",
      "description": "Last risk-relevant Stripe payouts_enabled observation. False is sticky until an explicit governed reconnect/review; positive webhooks do not auto-reactivate."
    },
    "provider_capability_observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_capability_event_id": {
      "type": "string",
      "description": "Stripe event id that last established a degraded/deauthorized provider capability state."
    },
    "provider_event_revision": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "CAS revision for the one durable connected-account webhook claim hosted by this Integration."
    },
    "provider_event_claim_state": {
      "type": "string",
      "enum": [
        "IDLE",
        "CLAIMED",
        "APPLYING",
        "COMPLETED",
        "REVIEW_REQUIRED"
      ],
      "default": "IDLE"
    },
    "provider_event_claim_key": {
      "type": "string",
      "description": "Stable stripe-connect:<event.id>:<event.account> effect key for the current/last claim."
    },
    "provider_event_claim_token": {
      "type": "string",
      "description": "Opaque fencing token for the current provider event owner. Not a provider credential."
    },
    "provider_event_claim_owner": {
      "type": "string"
    },
    "provider_event_claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_event_claim_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_event_effects_started": {
      "type": "boolean",
      "default": false
    },
    "provider_event_effect_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_event_last_processed_id": {
      "type": "string"
    },
    "provider_event_last_processed_type": {
      "type": "string"
    },
    "provider_event_last_processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_event_receipt_json": {
      "type": "object",
      "description": "Non-secret step receipts for the last Stripe connected-account transition."
    },
    "provider_event_last_error": {
      "type": "string"
    },
    "metadata_json": {
      "type": "object",
      "description": "Free-form metadata from the provider (account name, currency, auth_method, etc). Never put secrets here."
    },
    "integration_data_quality": {
      "type": "object",
      "description": "Per-sync-run snapshot of structural data-quality gaps surfaced by the upstream provider API. Computed by dataSyncAgent at every sync run from the registry's known_data_gaps for this provider. Purely INFORMATIONAL: NEVER consumed by computeVerticalStatus, generateRecommendations, savings, benchmarks, or any business-logic score. UI surfaces it as a read-only badge. Decision to connect this to recommendation confidence is pending product input \u2014 do not wire it without explicit approval.",
      "properties": {
        "completeness_pct": {
          "type": "number",
          "description": "100 if the provider has no known_data_gaps in the registry; 70 if at least one known gap is present. Single fixed step on purpose \u2014 per-gap severity weighting is future work."
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Snapshot of registry.known_data_gaps at sync time. [] when no gaps."
        },
        "evidence": {
          "type": "string",
          "description": "Human-readable one-line explanation of the gap(s), for UI display."
        },
        "computed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "required": [
    "brand_id",
    "provider",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    },
    "write": {
      "user_condition": {
        "role": "__service_role_only__"
      }
    }
  }
}
