{
  "name": "PaymentsRateImportQuarantine",
  "type": "object",
  "description": "Rows from blocked.csv. They are retained for audit but can never become active rate candidates.",
  "properties": {
    "pack_id": { "type": "string" },
    "pack_source_file": { "type": "string" },
    "pack_source_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_row_number": { "type": "number" },
    "source_row_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_row_key": { "type": "string" },
    "materialization_version": { "type": "string" },
    "materialized_row_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ingestion_batch_id": { "type": "string" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "last_reconciled_at": { "type": "string", "format": "date-time" },
    "country": { "type": "string" },
    "provider_name": { "type": "string" },
    "provider_slug": { "type": "string" },
    "plan": { "type": "string" },
    "channel": { "type": "string" },
    "scheme": { "type": "string" },
    "funding": { "type": "string" },
    "issuer_region": { "type": "string" },
    "tier": { "type": "string" },
    "rate_bps": { "type": "number" },
    "fixed_minor": { "type": "number" },
    "currency": { "type": "string" },
    "source_url": { "type": "string" },
    "source_quote": { "type": "string" },
    "verified_at": { "type": "string", "format": "date-time" },
    "source_type": { "type": "string" },
    "seed_status": { "type": "string" },
    "blocked_reason": { "type": "string" },
    "provenance": { "type": "string" },
    "blocked_record_json": { "type": "object" },
    "commercial_eligibility": { "type": "string" },
    "quarantine_status": { "type": "string", "enum": ["BLOCKED_SOURCE_CONFLICT"] },
    "active": { "type": "boolean", "default": false },
    "is_synthetic": { "type": "boolean", "default": false }
  },
  "required": ["pack_id", "source_row_key", "source_row_sha256", "materialized_row_sha256", "country", "provider_name", "blocked_reason", "quarantine_status", "active", "is_synthetic"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "write": { "user_condition": { "role": "admin" } }
  }
}
