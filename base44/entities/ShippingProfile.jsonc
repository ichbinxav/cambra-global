{
  "name": "ShippingProfile",
  "type": "object",
  "description": "DEPRECATED \u2014 V1 multi-vertical entity, no live code path writes or reads it since the payments-only cutover (FASE 1.3 removed ShippingModule). Kept for historical data; admin-only RLS (SECURITY-1, 2026-07-24). Do not delete.",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "carriers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelo": {
      "type": "string",
      "enum": [
        "agregador",
        "directo"
      ],
      "description": "DEPRECATED: use shipping_model"
    },
    "shipping_model": {
      "type": "string",
      "enum": [
        "aggregator",
        "direct"
      ]
    },
    "three_pl": {
      "type": "boolean",
      "default": false
    },
    "in_house": {
      "type": "boolean",
      "default": true
    },
    "paises_serv": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DEPRECATED: use served_countries"
    },
    "served_countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domestic_vs_intl": {
      "type": "number",
      "description": "DEPRECATED: use domestic_share_percent (0-100)"
    },
    "domestic_share_percent": {
      "type": "number"
    },
    "pedidos_mensuales": {
      "type": "number",
      "description": "DEPRECATED: use monthly_orders"
    },
    "monthly_orders": {
      "type": "number"
    },
    "avg_weight": {
      "type": "number",
      "description": "DEPRECATED: use avg_weight_kg"
    },
    "avg_weight_kg": {
      "type": "number"
    },
    "dims": {
      "type": "string",
      "description": "DEPRECATED: use dimensions"
    },
    "dimensions": {
      "type": "string"
    },
    "returns_rate": {
      "type": "number",
      "description": "DEPRECATED: use return_rate_percent"
    },
    "return_rate_percent": {
      "type": "number"
    },
    "coste_envio": {
      "type": "number",
      "description": "DEPRECATED: use shipping_cost_eur"
    },
    "shipping_cost_eur": {
      "type": "number"
    },
    "mix_express_standard": {
      "type": "number",
      "description": "DEPRECATED: use express_mix_percent"
    },
    "express_mix_percent": {
      "type": "number"
    },
    "warehouse_model": {
      "type": "string",
      "enum": [
        "propio",
        "3pl",
        "hibrido",
        "otro",
        "own",
        "3pl",
        "hybrid",
        "other"
      ]
    },
    "pain_points": {
      "type": "string"
    },
    "current_providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completeness_score": {
      "type": "number",
      "default": 0
    },
    "readiness_score": {
      "type": "number",
      "default": 0
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "metadata_json": {
      "type": "object"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}