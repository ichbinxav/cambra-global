{
  "name": "BenchmarkCohort",
  "type": "object",
  "properties": {
    "cohort_key": {
      "type": "string",
      "description": "Format: 'tier|country|vertical'"
    },
    "source_population": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ],
      "description": "Acquisition population represented by this cohort. Inbound and outbound cohorts are stored and queried separately."
    },
    "data_origin": {
      "type": "string",
      "enum": [
        "observed_contributions",
        "synthetic_seed"
      ],
      "description": "Whether statistics were derived from validated merchant contributions or are synthetic development fixtures. synthetic_seed is never publishable or served as a network benchmark."
    },
    "vertical": {
      "type": "string"
    },
    "metric_key": {
      "type": "string"
    },
    "revenue_tier": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "is_eu": {
      "type": "boolean"
    },
    "month": {
      "type": "string",
      "description": "YYYY-MM"
    },
    "n": {
      "type": "number",
      "description": "Privacy-safe sample size: distinct merchants remaining after validation, per-merchant precedence and outlier handling."
    },
    "median": {
      "type": "number"
    },
    "p25": {
      "type": "number"
    },
    "p75": {
      "type": "number"
    },
    "avg": {
      "type": "number"
    },
    "best_in_class": {
      "type": "number",
      "description": "p10 \u2014 top 10% performers"
    },
    "engine_version": {
      "type": "string"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "True only when publication_status=PUBLISHABLE, n >= 20 distinct merchants and the merchant-weight cap is satisfied. Frontend must never see is_public=false cohorts."
    },
    "publication_status": {
      "type": "string",
      "enum": [
        "ABSTAIN",
        "INDICATIVE",
        "PUBLISHABLE"
      ],
      "description": "ABSTAIN below 10 distinct merchants (no statistics), INDICATIVE for 10-19 (internal only), PUBLISHABLE from 20 (eligible for public access)."
    },
    "max_merchant_weight": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.2,
      "description": "Largest merchant weight in the derived cohort. P4 uses equal one-vote-per-distinct-merchant weighting and never permits a merchant to exceed 20%."
    },
    "weighting_policy": {
      "type": "string",
      "enum": [
        "EQUAL_ONE_VOTE_PER_DISTINCT_MERCHANT"
      ]
    },
    "benchmark_version": {
      "type": "string"
    },
    "derivation_version": {
      "type": "string"
    },
    "minimum_cohort_size": {
      "type": "number",
      "minimum": 10
    },
    "raw_distinct_merchants": {
      "type": "number"
    },
    "excluded_outlier_count": {
      "type": "number"
    },
    "outlier_policy": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW", "INSUFFICIENT"]
    },
    "derivation_status": {
      "type": "string",
      "enum": ["AVAILABLE", "INSUFFICIENT_DATA"]
    },
    "insufficient_data_reason": {
      "type": "string"
    },
    "source_count_json": {
      "type": "object"
    },
    "lineage_hash": {
      "type": "string"
    },
    "derived_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "cohort_key",
    "source_population",
    "data_origin",
    "vertical",
    "metric_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
