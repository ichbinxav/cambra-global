{
  "name": "BenchmarkCohort",
  "type": "object",
  "properties": {
    "cohort_key": {
      "type": "string",
      "description": "Format: 'tier|country|vertical'"
    },
    "vertical": {
      "type": "string"
    },
    "metric_key": {
      "type": "string"
    },
    "revenue_tier": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "is_eu": {
      "type": "boolean"
    },
    "month": {
      "type": "string",
      "description": "YYYY-MM"
    },
    "n": {
      "type": "number",
      "description": "Privacy-safe sample size: distinct merchants remaining after validation, per-merchant precedence and outlier handling."
    },
    "median": {
      "type": "number"
    },
    "p25": {
      "type": "number"
    },
    "p75": {
      "type": "number"
    },
    "avg": {
      "type": "number"
    },
    "best_in_class": {
      "type": "number",
      "description": "p10 \u2014 top 10% performers"
    },
    "engine_version": {
      "type": "string"
    },
    "is_public": {
      "type": "boolean",
      "default": false,
      "description": "True only when n >= 10 distinct merchants under the versioned P4 policy. Frontend must never see is_public=false cohorts."
    },
    "benchmark_version": {
      "type": "string"
    },
    "derivation_version": {
      "type": "string"
    },
    "minimum_cohort_size": {
      "type": "number",
      "minimum": 10
    },
    "raw_distinct_merchants": {
      "type": "number"
    },
    "excluded_outlier_count": {
      "type": "number"
    },
    "outlier_policy": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW", "INSUFFICIENT"]
    },
    "derivation_status": {
      "type": "string",
      "enum": ["AVAILABLE", "INSUFFICIENT_DATA"]
    },
    "insufficient_data_reason": {
      "type": "string"
    },
    "source_count_json": {
      "type": "object"
    },
    "lineage_hash": {
      "type": "string"
    },
    "derived_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "cohort_key",
    "vertical",
    "metric_key"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
