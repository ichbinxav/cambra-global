{
  "name": "Recommendation",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string"
    },
    "deal_activation_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "vertical": {
      "type": "string",
      "enum": [
        "payments",
        "shipping",
        "saas",
        "general"
      ],
      "default": "general"
    },
    "type": {
      "type": "string",
      "enum": [
        "vertical_priority",
        "deal_suggestion",
        "missing_data",
        "next_action",
        "opportunity_ranking",
        "unlock_savings"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "expected_benefit": {
      "type": "string"
    },
    "action_required": {
      "type": "string"
    },
    "action_link": {
      "type": "string"
    },
    "score_json": {
      "type": "object"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_data": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effort_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "seen_by_user_at": {
      "type": "string",
      "format": "date-time"
    },
    "dismissed_by_user_at": {
      "type": "string",
      "format": "date-time"
    },
    "admin_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "seen",
        "dismissed",
        "implemented",
        "archived",
        "proposed",
        "awaiting_authorization"
      ],
      "default": "active"
    }
  },
  "required": [
    "type",
    "title",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}