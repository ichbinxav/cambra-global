{
  "name": "StripeConnection",
  "type": "object",
  "properties": {
    "brand_id": {
      "type": "string",
      "description": "Brand this Stripe connection belongs to."
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe account ID, e.g. acct_xxx. NOT a credential."
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "connected",
        "disconnected",
        "error"
      ],
      "default": "connected"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "monthly_volume": {
      "type": "number",
      "description": "Last window total charge volume (net, in major units)."
    },
    "effective_fee_pct": {
      "type": "number",
      "description": "Computed effective rate (canonical measured_current_bps / 100) \u2014 CANONICAL M3 definition: fees / net volume over rows whose reporting_category \u2208 {charge, refund, partial_capture_reversal}."
    },
    "total_fees_monthly": {
      "type": "number"
    },
    "total_transactions": {
      "type": "number"
    },
    "avg_order_value": {
      "type": "number"
    },
    "fee_breakdown": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "pct": {
            "type": "number"
          }
        }
      },
      "description": "Breakdown by fee type from Stripe balance transactions."
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "data_as_of": {
      "type": "string",
      "format": "date-time",
      "description": "When the Stripe data was last fetched."
    },
    "confidence_level": {
      "type": "string",
      "enum": [
        "connected",
        "verified"
      ],
      "default": "connected"
    },
    "is_test": {
      "type": "boolean",
      "default": false,
      "description": "TEST-MODE BRIDGE \u2014 when true, stripeDataSync authenticates with STRIPE_TEST_SECRET_KEY and DOES NOT send the Stripe-Account header. Used exclusively by the M3 validation harness against Stripe test-mode accounts. Retire when per-merchant Connect OAuth ships (real merchants connect their own Stripe via OAuth; no need for a test bypass in production)."
    }
  },
  "required": [
    "brand_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}