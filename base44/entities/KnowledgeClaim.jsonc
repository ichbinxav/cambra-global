{
  "name": "KnowledgeClaim",
  "type": "object",
  "description": "P12 versioned knowledge claim. Promotion is evidence-gated; weak/inferred evidence cannot unilaterally become verified operational truth.",
  "properties": {
    "claim_key": {
      "type": "string"
    },
    "semantic_key": {
      "type": "string"
    },
    "vertical": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "provider_slug": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "tenant_scope": {
      "type": "string",
      "enum": [
        "global",
        "tenant"
      ]
    },
    "domain": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "claim_type": {
      "type": "string"
    },
    "value_json": {
      "type": "object"
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_to": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "truth_level": {
      "type": "string",
      "enum": [
        "verified_official",
        "observed",
        "inferred"
      ]
    },
    "knowledge_state": {
      "type": "string",
      "enum": [
        "candidate",
        "observed",
        "corroborated",
        "verified",
        "active",
        "stale",
        "superseded",
        "archived",
        "quarantined"
      ],
      "default": "candidate"
    },
    "confidence": {
      "type": "number"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "number",
      "default": 1
    },
    "supersedes_claim_id": {
      "type": "string"
    },
    "content_hash": {
      "type": "string"
    },
    "quarantine_reason": {
      "type": "string"
    },
    "claim_use_class": {
      "type": "string",
      "enum": [
        "DESCRIPTIVE",
        "ADVISORY",
        "MODEL"
      ],
      "description": "Operational use class. DESCRIPTIVE or ADVISORY status never implies independent eligibility for model training, evaluation or calibration."
    },
    "promotion_decision_json": {
      "type": "object",
      "description": "Server-derived claim-promotion assessment with exact evidence/observation lineage. Manual reason text is audit context, never learning authority."
    },
    "learning_eligibility_decision_id": {
      "type": "string",
      "description": "Optional immutable Event-ledger decision reference. Absence means not learning eligible."
    },
    "training_eligible": {
      "type": "boolean",
      "default": false
    },
    "model_eligible": {
      "type": "boolean",
      "default": false
    },
    "calibration_eligible": {
      "type": "boolean",
      "default": false
    },
    "is_demo": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "claim_key",
    "semantic_key",
    "claim_type",
    "truth_level",
    "tenant_scope",
    "knowledge_state"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
