{
  "name":"LegalExecutionDecision","type":"object","description":"Immutable P11 execution decision and evidence linkage.",
  "properties":{
    "decision_key":{"type":"string"},"merchant_id":{"type":"string"},"jurisdiction":{"type":"string"},"requested_action":{"type":"string"},
    "provider_id":{"type":"string"},"case_id":{"type":"string"},
    "decision":{"type":"string","enum":["ALLOW","ALLOW_WITH_CONDITIONS","MERCHANT_APPROVAL_REQUIRED","HUMAN_REVIEW_REQUIRED","LEGAL_REVIEW_REQUIRED","BLOCK"]},
    "allowed":{"type":"boolean"},"reason_codes":{"type":"array","items":{"type":"string"}},"missing_requirements":{"type":"array","items":{"type":"string"}},
    "conditions":{"type":"array","items":{"type":"string"}},"policy_version":{"type":"string"},"regulatory_policy_version":{"type":"string"},
    "mandate_version":{"type":"string"},"contract_version":{"type":"string"},"authority_snapshot_id":{"type":"string"},
    "actor_id":{"type":"string"},"actor_type":{"type":"string"},"evaluated_at":{"type":"string","format":"date-time"},"engine_version":{"type":"string"}
  },
  "required":["decision_key","merchant_id","jurisdiction","requested_action","decision","allowed","evaluated_at","engine_version"],
  "rls":{"read":{"user_condition":{"role":"admin"}},"write":{"user_condition":{"role":"admin"}}}
}
