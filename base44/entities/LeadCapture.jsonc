{
  "name": "LeadCapture",
  "type": "object",
  "description": "Public lead capture \u2014 creation stays open by design (anonymous funnel); reads/updates/deletes admin-only (SECURITY-1, 2026-07-24).",
  "properties": {
    "email": {
      "type": "string"
    },
    "whatsapp": {
      "type": "string"
    },
    "consent": {
      "type": "boolean",
      "default": false
    },
    "source_page": {
      "type": "string"
    },
    "opted_in_benchmark": {
      "type": "boolean",
      "default": false
    },
    "first_submitted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "email",
    "consent"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}