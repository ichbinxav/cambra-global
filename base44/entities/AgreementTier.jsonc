{
  "name": "AgreementTier",
  "type": "object",
  "description": "P14 machine-readable dynamic commercial tier evaluated deterministically against explicit AggregatePool metrics.",
  "properties": {
    "tier_key": {
      "type": "string"
    },
    "agreement_id": {
      "type": "string"
    },
    "tier_number": {
      "type": "number"
    },
    "name": {
      "type": "string"
    },
    "metric": {
      "type": "string",
      "enum": [
        "observed_volume",
        "addressable_volume",
        "committed_volume",
        "active_merchant_count",
        "transaction_count"
      ]
    },
    "threshold_value": {
      "type": "number"
    },
    "secondary_conditions_json": {
      "type": "object"
    },
    "pricing_json": {
      "type": "object"
    },
    "rebate_json": {
      "type": "object"
    },
    "activation_mode": {
      "type": "string",
      "enum": [
        "automatic_contractual",
        "provider_confirmation",
        "manual"
      ]
    },
    "provider_validation_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "confirmed",
        "rejected"
      ]
    },
    "qualification_status": {
      "type": "string",
      "enum": [
        "locked",
        "qualified",
        "pending_confirmation",
        "active",
        "superseded"
      ]
    },
    "progress_pct": {
      "type": "number"
    },
    "amount_remaining": {
      "type": "number"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tier_key",
    "agreement_id",
    "tier_number",
    "metric",
    "threshold_value",
    "pricing_json",
    "activation_mode",
    "qualification_status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}