      "type": "number",
      "description": "DEPRECATED: use blended_rate_percent"
    },
    "blended_rate_percent": {
      "type": "number"
    },
    "canales": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "online",
          "in_store",
          "omni"
        ]
      },
      "description": "DEPRECATED: use channels"
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "online",
          "in_store",
          "omni"
        ]
      }
    },
    "paises": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DEPRECATED: use countries"
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "monedas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "DEPRECATED: use currencies"
    },
    "currencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vol_mensual": {
      "type": "number",
      "description": "DEPRECATED: use monthly_volume_eur"
    },
    "monthly_volume_eur": {
      "type": "number"
    },
    "tx_mensuales": {
      "type": "number",
      "description": "DEPRECATED: use monthly_tx_count"
    },
    "monthly_tx_count": {
      "type": "number"
    },
    "aov": {
      "type": "number",
      "description": "DEPRECATED: use average_order_value_eur"
    },
    "average_order_value_eur": {
      "type": "number"
    },
    "refunds_rate": {
      "type": "number",
      "description": "DEPRECATED: use refunds_rate_percent"
    },
    "refunds_rate_percent": {
      "type": "number"
    },
    "chargeback_rate": {
      "type": "number",
      "description": "DEPRECATED: use chargeback_rate_percent"
    },
    "chargeback_rate_percent": {
      "type": "number"
    },
    "payout_timing": {
      "type": "number",
      "description": "DEPRECATED: use payout_days"
    },
    "payout_days": {
      "type": "number"
    },
    "fraude_flags": {
      "type": "string",
      "description": "DEPRECATED: use risk_notes"
    },
    "risk_notes": {
      "type": "string"
    },
    "terminal_provider": {
      "type": "string"
    },
    "tpe_provider": {
      "type": "string"
    },
    "terminal_count": {
      "type": "number"
    },
    "monthly_terminal_rental": {
      "type": "number"
    },
    "fixed_fees_monthly": {
      "type": "number"
    },
    "fixed_banking_fees": {
      "type": "number"
    },
    "maintenance_fees": {
      "type": "number"
    },
