      "type": "number"
    },
    "in_store_gmv": {
      "type": "number"
    },
    "in_store_average_ticket": {
      "type": "number"
    },
    "in_store_avg_ticket": {
      "type": "number"
    },
    "tpe_transaction_fee_percent": {
      "type": "number"
    },
    "tpe_transaction_fee_pct": {
      "type": "number"
    },
    "card_mix_percent": {
      "type": "number"
    },
    "card_mix_pct": {
      "type": "number"
    },
