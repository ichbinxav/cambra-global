      "type": "object",
      "description": "DEPRECATED: use contract",
      "properties": {
        "renovacion_en": {
          "type": "string",
          "format": "date"
        },
        "tipo": {
          "type": "string",
          "enum": [
            "mensual",
            "anual",
            "otro"
          ]
        }
      }
    },
    "contract": {
      "type": "object",
      "properties": {
        "renewal_on": {
          "type": "string",
          "format": "date"
        },
        "type": {
          "type": "string",
          "enum": [
            "monthly",
            "annual",
            "other"
          ]
        }
      }
    },
    "frustraciones": {
      "type": "string",
      "description": "DEPRECATED: use frustrations"
    },
    "frustrations": {
      "type": "string"
    },
    "current_providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completeness_score": {
      "type": "number",
      "default": 0
    },
    "readiness_score": {
      "type": "number",
      "default": 0
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "metadata_json": {
      "type": "object"
    }
  },
  "required": []
}