{
  "name": "CampaignEnrollment",
  "type": "object",
  "description": "Canonical per-recipient enrollment of a contact/company in a CommercialCampaign audience version. Owns eligibility, exclusion, sequence position and the honest send/engagement state projection. Provider IDs are transport references only.",
  "properties": {
    "enrollment_key": { "type": "string", "description": "Stable unique key: campaign + audience version + normalized email hash." },
    "campaign_id": { "type": "string" },
    "audience_version_id": { "type": "string" },
    "lane": { "type": "string", "enum": ["MERCHANT_ACQUISITION", "PARTNER_ACQUISITION", "PROVIDER_RELATIONS", "MERCHANT_LIFECYCLE"] },
    "objective_type": { "type": "string" },
    "subject_type": { "type": "string", "enum": ["OutboundLead", "PartnerProspect", "ProviderContact", "Brand", "MANUAL"] },
    "subject_id": { "type": "string" },
    "lead_id": { "type": "string" },
    "partner_id": { "type": "string" },
    "provider_contact_id": { "type": "string" },
    "brand_id": { "type": "string" },
    "company_key": { "type": "string" },
    "company_name": { "type": "string" },
    "contact_id": { "type": "string" },
    "email_normalized": { "type": "string" },
    "email_hash": { "type": "string" },
    "market": { "type": "string" },
    "city": { "type": "string" },
    "language": { "type": "string" },
    "timezone": { "type": "string" },
    "eligibility_status": { "type": "string", "enum": ["ELIGIBLE", "EXCLUDED", "REVIEW_REQUIRED", "UNKNOWN"], "default": "UNKNOWN" },
    "eligibility_reasons": { "type": "array", "items": { "type": "string" } },
    "exclusion_status": { "type": "string" },
    "exclusion_reason": { "type": "string" },
    "contact_priority": { "type": "number" },
    "company_contact_rank": { "type": "number", "minimum": 1 },
    "content_version_id": { "type": "string" },
    "sequence_version_id": { "type": "string" },
    "variant_key": { "type": "string" },
    "current_step": { "type": "number", "minimum": 0, "default": 0 },
    "next_action_at": { "type": "string", "format": "date-time" },
    "sending_profile_key": { "type": "string" },
    "thread_id": { "type": "string" },
    "provider_refs_json": { "type": "object" },
    "operation_key": { "type": "string" },
    "effect_key": { "type": "string" },
    "state": {
      "type": "string",
      "enum": [
        "ELIGIBLE", "EXCLUDED", "QUEUED", "SCHEDULED", "CLAIMED", "SEND_STARTED",
        "PROVIDER_ACCEPTED", "DELIVERED_OBSERVED", "OPEN_OBSERVED", "CLICK_OBSERVED",
        "SITE_VISIT_OBSERVED", "ANALYZER_STARTED", "REPLIED", "POSITIVE_REPLY",
        "NEUTRAL_REPLY", "NEGATIVE_REPLY", "WRONG_CONTACT", "OUT_OF_OFFICE",
        "BOUNCED", "UNSUBSCRIBED", "COMPLAINT", "MEETING_BOOKED",
        "CONNECTION_STARTED", "CONNECTION_COMPLETED", "QUALIFIED",
        "OPPORTUNITY_CREATED", "RECOVER_CREATED", "CONVERTED", "STOPPED",
        "REVIEW_REQUIRED"
      ],
      "default": "ELIGIBLE"
    },
    "commercial_outcome": { "type": "string" },
    "stop_reason": { "type": "string" },
    "last_event_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "revision": { "type": "number", "minimum": 0, "default": 0 },
    "source": { "type": "string", "description": "LEGACY_BACKFILL when derived from CommercialCampaign.lead_ids + existing messages/events." }
  },
  "required": ["enrollment_key", "campaign_id", "audience_version_id", "subject_type", "state"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "write": { "user_condition": { "role": "__service_role_only__" } }
  }
}
