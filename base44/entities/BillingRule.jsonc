{
  "name": "BillingRule",
  "type": "object",
  "properties": {
    "deal_id": {
      "type": "string",
      "description": "Legacy: previous ambiguous reference"
    },
    "deal_activation_id": {
      "type": "string",
      "description": "Canonical: references DealActivation.id"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "billing_model": {
      "type": "string",
      "enum": [
        "monthly_success_fee"
      ],
      "default": "monthly_success_fee"
    },
    "model": {
      "type": "string",
      "enum": [
        "monthly_success_fee"
      ],
      "default": "monthly_success_fee",
      "description": "Legacy compatibility"
    },
    "node_share_percent": {
      "type": "number",
      "default": 25
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "effective_start_date": {
      "type": "string",
      "format": "date"
    },
    "effective_end_date": {
      "type": "string",
      "format": "date"
    },
    "terms_version": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Legacy compatibility"
    },
    "min_fee": {
      "type": "number"
    },
    "cap_fee": {
      "type": "number"
    }
  },
  "required": [
    "billing_model",
    "node_share_percent"
  ]
}