{
  "name": "BillingRule",
  "type": "object",
  "properties": {
    "deal_activation_id": {
      "type": "string"
    },
    "brand_id": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "billing_model": {
      "type": "string",
      "enum": [
        "monthly_success_fee"
      ],
      "default": "monthly_success_fee"
    },
    "node_share_percent": {
      "type": "number",
      "default": 25
    },
    "min_fee": {
      "type": "number"
    },
    "cap_fee": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "EUR"
    },
    "effective_start_date": {
      "type": "string",
      "format": "date"
    },
    "effective_end_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "archived"
      ],
      "default": "active"
    },
    "terms_version": {
      "type": "string"
    },
    "policy_version": {
      "type": "string",
      "description": "v60.1 (2026-08-05) \u2014 policyVersion in force when this rule was created. Written by referralBilling.scheduleReferralFee from the generated PRODUCT_POLICY. Optional; legacy rules carry no value and the resolver treats them as legacy_pre_policy_registry."
    },
    "notes": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "billing_model",
    "node_share_percent",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}