{
  "name": "ProviderRevenueStatement",
  "type": "object",
  "description": "P15 sanitized provider reporting used for commission reconciliation. Never stores raw bank credentials or payment secrets.",
  "properties": {
    "statement_key": {
      "type": "string"
    },
    "provider_id": {
      "type": "string"
    },
    "agreement_id": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "reported_volume": {
      "type": "number"
    },
    "reported_merchants": {
      "type": "number"
    },
    "reported_amount_minor": {
      "type": "number"
    },
    "line_items_json": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "source_document_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "parsed",
        "reconciled",
        "mismatch",
        "approved"
      ]
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    },
    "reconciled_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "statement_key",
    "provider_id",
    "period",
    "currency",
    "status",
    "received_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
