{
  "name": "Encrypted SharePoint disaster-recovery continuation \u2014 10 min",
  "description": "Resumes an existing encrypted backup operation in bounded durable slices. It never starts a backup when no pending operation exists.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 10,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-26T01:08:44.503000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "encrypted_sharepoint_disaster_recovery_continuation_10_min",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "maintenanceEngine",
            "args": {
              "host_action": "disaster_recovery_backup_continue",
              "hosted_worker": "disasterRecoveryBackupContinuation",
              "internal_secret": "{{INTERNAL_CALL_SECRET}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "maintenanceEngine"
  }
}