{
  "name": "Encrypted SharePoint disaster-recovery backup \u2014 daily (consolidated)",
  "description": "Creates a policy-selected full or incremental encrypted backup in CAMBRA INFRASTRUCTURE / Production Backups. Fails closed when service identity, site grant, encryption key or release identity is absent.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "days",
      "interval_anchor": "2026-08-13T00:37:17.021000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "encrypted_sharepoint_disaster_recovery_backup_daily_consolidated",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "maintenanceEngine",
            "args": {
              "host_action": "disaster_recovery_backup",
              "hosted_worker": "disasterRecoveryBackup",
              "backup_mode": "AUTO",
              "internal_secret": "{{INTERNAL_CALL_SECRET}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "maintenanceEngine"
  }
}