{
  "name": "CAMBRA Autonomous Maintenance \u2014 10 min",
  "description": "P17 governed maintenance sweep. Material financial, security, contract, permission and deployment actions remain human-gated.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 10,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-11T21:24:08.872000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "cambra_autonomous_maintenance_10_min",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "maintenanceEngine",
            "args": {
              "internal_secret": "{{INTERNAL_CALL_SECRET}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "maintenanceEngine"
  }
}