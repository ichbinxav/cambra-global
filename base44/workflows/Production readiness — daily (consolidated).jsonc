{
  "name": "Production readiness \u2014 daily (consolidated)",
  "description": "Runs the original fail-closed productionReadinessWorker handler through maintenanceEngine.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "days",
      "interval_anchor": "2026-08-12T12:19:21.023000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "production_readiness_daily_consolidated",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "maintenanceEngine",
            "args": {
              "host_action": "production_readiness",
              "hosted_worker": "productionReadinessWorker",
              "internal_secret": "{{INTERNAL_CALL_SECRET}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "maintenanceEngine"
  }
}