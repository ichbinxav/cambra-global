{
  "name": "Instantly inbound event recovery",
  "description": "Dedicated hosted route for authenticated provider-event retry every 5 minutes.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-08-23T17:44:02.697000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "instantly_inbound_event_recovery",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processWebhookDeadLetters",
            "args": {
              "hosted_worker": "instantlyProviderEventRetryWorker"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "processWebhookDeadLetters"
  }
}