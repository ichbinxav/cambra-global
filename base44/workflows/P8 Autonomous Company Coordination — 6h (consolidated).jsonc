{
  "name": "P8 Autonomous Company Coordination \u2014 6h (consolidated)",
  "description": "Runs the original autonomousCompanyOrchestrator handler inside the existing internal supervisor boundary.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 6,
      "interval_unit": "hours",
      "interval_anchor": "2026-08-12T12:06:10.326000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "p8_autonomous_company_coordination_6h_consolidated",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autonomousOperationsSupervisor",
            "args": {
              "host_action": "autonomous_company_orchestrator",
              "hosted_worker": "autonomousCompanyOrchestrator",
              "internal_secret": "{{INTERNAL_CALL_SECRET}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autonomousOperationsSupervisor"
  }
}