{
  "name": "Growth Path + Europe-33 recompute \u2014 6h",
  "description": "Recomputes the evidence-limited market portfolio and Growth Path snapshot. Recommendation-only; no send, spend, contract, migration or billing execution.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 6,
      "interval_unit": "hours",
      "interval_anchor": "2026-08-11T17:00:19.648000",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "growth_path_europe_33_recompute_6h",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "getEuropeMarketsCommandCenter",
            "args": {
              "view": "growth",
              "action": "recompute",
              "source": "scheduled",
              "hosted_workers": [
                "europeanGrowthIntelligenceWorker",
                "getEuropeanGrowthCommandCenter"
              ],
              "confirmation": "RECOMPUTE_GROWTH_PATH",
              "internal_secret": "{{INTERNAL_CALL_SECRET}}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "getEuropeMarketsCommandCenter"
  }
}