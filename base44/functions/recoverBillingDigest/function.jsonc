{
  "name": "recoverBillingDigest",
  "automations": [
    {
      "type": "scheduled",
      "name": "Recover billing weekly digest",
      "description": "Weekly operational reminder for missing Recover reports, approvals, invoice-ready reports and blockers. Read-only apart from sending the configured admin digest and its audit log; it never approves or invoices.",
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "days",
      "repeat_interval": 7,
      "start_time": "07:00",
      "ends_type": "never",
      "function_name": "recoverBillingDigest",
      "function_args": {
        "trigger": "scheduled"
      }
    }
  ],
  "entry": "serve.ts"
}
