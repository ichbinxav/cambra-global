{
  "name": "outlookInboundRouter",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "name": "Outlook Commercial Inbound — every 5 minutes",
      "description": "Polls Outlook for replies associated with active CAMBRA commercial threads. Dedupe and bounded lookback make each run idempotent.",
      "function_args": {},
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "minutes",
      "repeat_interval": 5,
      "ends_type": "never"
    }
  ]
}
