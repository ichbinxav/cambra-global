{
  "name": "processWebhookDeadLetters",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "name": "Webhook Dead Letter Retry",
      "description": "P7 bounded webhook retry worker every 5 minutes. Claims due rows before delivery, preserves the stable delivery id, and quarantines post-effect ambiguity.",
      "function_args": {
        "limit": 50
      },
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "minutes",
      "repeat_interval": 5,
      "ends_type": "never",
      "function_name": "processWebhookDeadLetters",
      "starts_at": "2026-08-09T16:00:00.000Z"
    },
    {
      "type": "scheduled",
      "name": "Instantly inbound event recovery",
      "description": "Dedicated hosted route for authenticated provider-event retry every 5 minutes.",
      "function_args": {
        "hosted_worker": "instantlyProviderEventRetryWorker"
      },
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "minutes",
      "repeat_interval": 5,
      "ends_type": "never",
      "function_name": "processWebhookDeadLetters",
      "starts_at": "2026-08-11T00:00:00.000Z"
    },
    {
      "type": "scheduled",
      "name": "Instantly state reconciliation",
      "description": "Dedicated hosted route for bounded provider reconciliation every 15 minutes.",
      "function_args": {
        "hosted_worker": "instantlyReconciliationWorker"
      },
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "minutes",
      "repeat_interval": 15,
      "ends_type": "never",
      "function_name": "processWebhookDeadLetters",
      "starts_at": "2026-08-11T00:00:00.000Z"
    },
    {
      "type": "scheduled",
      "name": "AgentTask terminal Event reconciliation",
      "description": "Reconciles durable terminal Event outbox intents through an exact-key read, one bounded create attempt and post-write readback. Ambiguity is quarantined and exactly-once is not claimed.",
      "function_args": {
        "hosted_worker": "agentTaskTerminalEventReconciler",
        "limit": 50
      },
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "minutes",
      "repeat_interval": 5,
      "ends_type": "never",
      "function_name": "processWebhookDeadLetters",
      "starts_at": "2026-08-21T14:00:00.000Z"
    }
  ]
}
