{
  "name": "providerRevenueBillingWorker",
  "automations": [
    {
      "name": "Provider revenue billing preparation",
      "function_args": {
        "internal_secret": "{{INTERNAL_CALL_SECRET}}"
      },
      "type": "scheduled",
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "months",
      "repeat_interval": 1,
      "repeat_on_day_of_month": 1,
      "start_time": "10:00",
      "ends_type": "never",
      "is_active": true
    }
  ],
  "entry": "entry.ts"
}
