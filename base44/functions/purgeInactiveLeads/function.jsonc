{
  "name": "purgeInactiveLeads",
  "automations": [
    {
      "type": "scheduled",
      "name": "Lead retention purge",
      "description": "Runs the LEGAL-2 retention purge on a conservative 30-day cadence. The handler itself enforces the 12/24-month retention windows and is idempotent.",
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "days",
      "repeat_interval": 30,
      "start_time": "01:30",
      "ends_type": "never",
      "function_args": {}
    }
  ],
  "entry": "entry.ts"
}
