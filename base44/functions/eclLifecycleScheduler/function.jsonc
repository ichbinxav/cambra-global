{
  "name": "eclLifecycleScheduler",
  "entry": "entry.ts",
  "automations": [
    {
      "type": "scheduled",
      "name": "ECL Lifecycle Sweep",
      "description": "ECL P4 lifecycle sweep every 15 minutes. Processes due provisional evidence, reminder intents, expiry and bounded review escalation. No billing or monetary side effects.",
      "function_args": {
        "limit": 25
      },
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "minutes",
      "repeat_interval": 15,
      "ends_type": "never"
    }
  ]
}
