{
  "name": "retryPendingRecoverContracts",
  "automations": [
    {
      "type": "scheduled",
      "name": "Recover contract delivery reconciler",
      "description": "Retries only pending Recover contract generation/delivery every 15 minutes. Idempotent and bounded; it does not approve Recover, alter evidence, or create invoices.",
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "simple",
      "repeat_unit": "minutes",
      "repeat_interval": 15,
      "ends_type": "never",
      "function_args": {}
    }
  ],
  "entry": "serve.ts"
}
