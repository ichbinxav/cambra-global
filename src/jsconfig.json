{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "checkJs": false,
    "allowJs": true,
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "src/**/*",
    "base44/functions/**/*"
  ],
  "_comment_exclude": "src/components/ui is auto-generated by shadcn — excluded from typecheck to avoid noise from untyped Radix wrappers",
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "src/vite-plugins",
    "src/components/ui",
    "src/api",
    "src/lib"
  ]
}