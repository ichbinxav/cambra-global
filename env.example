# ══════════════════════════════════════════════════════════════════════
# CAMBRA — environment template (TRUTH-1, 2026-07-24)
# Named `env.example` (no leading dot) because the Base44 sandbox silently
# drops dotfiles. Copy to `.env` locally:  cp env.example .env
#
# EVERY VALUE BELOW IS A FAKE PLACEHOLDER. Never commit real secrets.
# The variable list is generated from a grep of the code:
#   frontend → import.meta.env.*   backend → Deno.env.get(...)
# ══════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────
# FRONTEND (VITE_*) — bundled into the client by Vite. Safe to expose.
# These are normally injected automatically by the Base44 builder; you only
# need them for a fully local `npm run dev` outside the platform.
# ──────────────────────────────────────────────────────────────────────

# Base44 app id — from the Base44 dashboard URL (Settings → General).
VITE_BASE44_APP_ID=000000000000000000000000

# Base44 API base URL — the platform's app API origin.
VITE_BASE44_APP_BASE_URL=https://base44.app

# Backend functions version tag — set by the Base44 builder; leave empty locally.
VITE_BASE44_FUNCTIONS_VERSION=

# ──────────────────────────────────────────────────────────────────────
# BACKEND (Deno) — NEVER put these in .env for the frontend build.
# Set in the Base44 dashboard → Settings → Environment Variables (secrets).
# Listed here for documentation only, with obviously fake values.
# ──────────────────────────────────────────────────────────────────────

# ── Core platform ─────────────────────────────────────────────────────
# Shared secret gating internal server-to-server function calls (internalGate).
# Generate: openssl rand -hex 32
INTERNAL_CALL_SECRET=fake-internal-secret-do-not-use

# Public origin of the deployed app (links in emails, OAuth redirects).
APP_DOMAIN=https://example.invalid

# Master AES-256-GCM key encrypting every stored OAuth/API-key blob.
# Generate: openssl rand -base64 32 — DO NOT rotate without a migration plan.
INTEGRATION_TOKEN_KEY=fake-base64-32-byte-key-do-not-use=

# Salt for anonymizing benchmark contributions. Generate: openssl rand -hex 16
BENCHMARK_ANON_SALT=fake-salt-do-not-use

# ── Public rate-limit network authority ───────────────────────────────
# Generate the current HMAC key with `openssl rand -base64 32` and store it
# only as a Base44 secret. Increment the opaque key version on every rotation.
# During a rotation window, set BOTH previous fields; remove them after all
# pre-rotation buckets have expired. Never commit real key material here.
RATE_LIMIT_HMAC_SECRET=
RATE_LIMIT_HMAC_SECRET_VERSION=key-2026-08-a
RATE_LIMIT_HMAC_PREVIOUS_SECRET=
RATE_LIMIT_HMAC_PREVIOUS_SECRET_VERSION=
# Base44 ingress must own/strip this header. Unconfigured proxy headers are
# ignored; missing or malformed trusted addresses fail closed.
RATE_LIMIT_TRUSTED_PROXY_HEADER=x-real-ip

# ── Rate limits & feature flags (plain values, not secrets) ───────────
# Hourly caps for the anonymous analyzer endpoints (integers).
PAYMENTS_ANALYSIS_RATE_LIMIT_PER_HOUR=30
PAYMENTS_GAP_TEASER_RATE_LIMIT_PER_HOUR=60
# Invoice-extraction pipeline toggles ("true"/"false").
EXTRACTION_LLM_ENABLED=false
EXTRACTION_L3_ENABLED=false

# ── Email (Resend) — resend.com → API Keys ────────────────────────────
RESEND_API_KEY=re_fake_000000000000000000000000
RESEND_FROM=CAMBRA <noreply@example.invalid>
ADMIN_NOTIFICATION_EMAIL=founder@example.invalid
FOUNDER_EMAIL=founder@example.invalid

# ── Stripe — dashboard.stripe.com → Developers → API keys ─────────────
STRIPE_SECRET_KEY=sk_test_fake000000000000000000000000
STRIPE_TEST_SECRET_KEY=sk_test_fake000000000000000000000000
# (STRIPE_PUBLISHABLE_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_CLIENT_ID are
#  configured as Base44 secrets for the OAuth/Connect flow.)

# ── AI providers ───────────────────────────────────────────────────────
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-fake00000000000000000000
# platform.openai.com → API Keys (extraction cross-check)
OPENAI_API_KEY=sk-fake0000000000000000000000000000
# perplexity.ai → API (research agents)
PERPLEXITY_API_KEY=pplx-fake000000000000000000000000

# ── Outbound / marketing tooling (agents; all optional) ───────────────
# app.apollo.io → Settings → API
APOLLO_API_KEY=fake-apollo-key
# attio.com → Workspace settings → API
ATTIO_API_KEY=fake-attio-key
# clay.com → Settings → API
CLAY_API_KEY=fake-clay-key
# instantly.ai → Settings → API
INSTANTLY_API_KEY=fake-instantly-key
# cal.com → Settings → Developer → API keys
CAL_API_KEY=fake-cal-key
# surferseo.com / taplio.com / typefully.com → account API settings
SURFER_API_KEY=fake-surfer-key
TAPLIO_API_KEY=fake-taplio-key
TYPEFULLY_API_KEY=fake-typefully-key
